+static bool
+usb_board_is(const char *want)
+{
+	DTEntry chosen;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	size_t n = strlen(want) + 1;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-board", &prop, &size) != kSuccess) {
+		return false;
+	}
+	return size >= n && memcmp(prop, want, n) == 0;
+}
 
 /* One plain 32-bit load or store per access: the hypervisor emulates the SMMU from the trapped instruction. */
