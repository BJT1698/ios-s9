+/*
+ * OP6 QUSB2: ABL leaves it configured but powered down. Clear POWER_DOWN as
+ * qusb2_phy_init's last step does and wait for the PLL; if it does not lock,
+ * the S9's full init (block reset + DT init sequence, the Qualcomm SDM845
+ * default) as a fallback. The registers are 8 bits wide (reads repeat the
+ * byte in all four lanes).
+ */
+static int
+op6_qusb2(vm_offset_t gcc)
+{
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+
+	if (!phy) {
+		return ENOMEM;
+	}
+	uint32_t pwr = s9_rd(phy + 0x210) & 0xff, pll = s9_rd(phy + 0x1a0) & 0xff;
+	printf("SWEET USB OP6: QUSB2 as ABL left it: PWR_CTRL1 0x%02x PLL_STATUS 0x%02x PORT_TUNE1 0x%02x\n",
+	    pwr, pll, s9_rd(phy + 0x240) & 0xff);
+	if (!(pwr & 1u) && (pll & 1u)) {
+		return 0;
+	}
+	s9_wr(phy + 0x210, pwr & ~1u);
+	delay(150);
+	if (s9_wait(phy + 0x1a0, 1u, 1u, 5000)) {
+		printf("SWEET USB OP6: QUSB2 powered up, PLL ready (PWR_CTRL1 0x%02x)\n", s9_rd(phy + 0x210) & 0xff);
+		return 0;
+	}
+	printf("SWEET USB OP6: QUSB2 PLL not ready (0x%02x): full init\n", s9_rd(phy + 0x1a0) & 0xff);
+	return s9_qusb2(gcc);
+}
+
+static bool
+op6_usb_start(vm_offset_t gcc)
+{
+	static const char *const bcms[] = { "SH3", "SN11", "SN0", "SN6", "CN0", "SN12" };
+	int smmu = 1;
+	int err = s9_rpmh_init();
+
+	/* sweetusbsmmu=0: leave the SMMU alone (if ABL's stream rule survives and the recipe hurts) */
+	PE_parse_boot_argn("sweetusbsmmu", &smmu, sizeof(smmu));
+	if (!err) {
+		/* Rail votes are logged, not fatal: ABL's own votes may still hold them. */
+		(void)s9_vreg("ldoa1", 880);
+		(void)s9_vreg("ldoa12", 1800);
+		(void)s9_vreg("ldoa24", 3088);
+		int bad = 0;
+		for (unsigned i = 0; i < sizeof(bcms) / sizeof(bcms[0]); i++) {
+			bad |= s9_bcm(bcms[i]);
+		}
+		if (bad) {
+			/* S9: without the config-port votes a read of the SMMU hangs the CPU */
+			printf("SWEET USB OP6: a bus vote failed: SMMU not touched, start abandoned\n");
+			err = EIO;
+		}
+	}
+	if (!err) {
+		/* SMMU TBU GDSC votes (Linux arm-smmu vdd-supply), as s9_gcc_usb */
+		const uint32_t tbu[2] = { S9_GCC_TBU1_VOTE, S9_GCC_TBU2_VOTE };
+		for (unsigned i = 0; i < 2; i++) {
+			s9_wr(gcc + tbu[i], s9_rd(gcc + tbu[i]) & ~1u);
+			(void)s9_wait(gcc + tbu[i], 1u << 31, 1u << 31, 20000);
+		}
+		if (smmu) {
+			err = s9_smmu_usb();
+		} else {
+			printf("SWEET USB OP6: SMMU left as ABL left it (sweetusbsmmu=0)\n");
+		}
+	}
+	if (!err) {
+		uint32_t gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+		bool on = (gdscr & (1u << 31)) != 0;
+		for (unsigned i = 0; i < 6 && on; i++) {        /* master .. ahb2phy */
+			on = !(usb_rd(gcc, usb_cbcr[i].off) & CBCR_CLK_OFF);
+		}
+		if (on) {
+			printf("SWEET USB OP6: GDSC and clocks on as ABL left them (warm start)\n");
+		} else if (gdscr & (1u << 31)) {
+			/* The S9 cold sequence resets the block expecting its clocks off (a reset with them on hung the S9). */
+			printf("SWEET USB OP6: GDSC on but some clocks off (GDSC 0x%08x): not handled, start abandoned\n", gdscr);
+			err = EIO;
+		} else {
+			printf("SWEET USB OP6: ABL left the USB block off (GDSC 0x%08x): cold start\n", gdscr);
+			err = s9_gcc_usb(gcc);
+			if (!err) {
+				err = s9_qusb2(gcc);
+			}
+		}
+	}
+	if (!err) {
+		err = op6_qusb2(gcc);
+	}
+	if (!err) {
+		s9_utmi_for_pipe();
+	}
+	printf("SWEET USB OP6: start %s (%d)\n", err ? "FAILED" : "done", err);
+	s9_cold = (err == 0);
+	return s9_cold;
+}
