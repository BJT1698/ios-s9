+			const struct sweet_surface_plane *p = &surface->planes[i];
+			int n = snprintf(planes + used, sizeof(planes) - used, ", p%u +0x%x bpr %u bpe %u %ux%u", i, p->offset,
+			    p->bytesPerRow, p->bytesPerElement, p->width, p->height);
+			if (n < 0) {
+				break;
+			}
+			used += (uint32_t)n;
+		}
+	}
 	if (surface->memory == NULL || surface->allocSize == 0) {
 		why = "no memory behind it";
 		ret = kIOReturnNotFound;
@@ -972,10 +1003,10 @@ SweetGPUUserClient::surfaceBuffer(struct sweet_surface_request *req)
