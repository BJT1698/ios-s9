+ * the surface: 'b3a8', which CoreAnimation's GPU renderer creates for the screen and which this
+ * system's bridge draws into as 'BGRA' and SweetFramebuffer shows from plane 0 (0109
+ * AppleCLCD::present); its second plane (8-bit opacity) is read by nobody here. 0 = offset and
+ * rowBytes are the surface's own (every kernel before 0113, and surfaces without such a plane).
+ * The 40-byte layout has no pad and is answered as before.
+ */
+#define SWEET_GPU_PLANE0                0x504c3042u     /* 'PL0B' */
 
 struct msm_timespec {
 	int64_t tv_sec;
@@ -918,7 +928,7 @@ static void
 sweet_gpu_import_log(const char *proc, bool failed, const char *fmt, ...)
 {
 	uint64_t n = SWEET_STAT_ADD(gStatImportLogs, 1);
-	char line[192];
+	char line[256];
 	va_list ap;
 
 	if (n >= SWEET_GPU_IMPORT_LOG_ALL &&
@@ -958,6 +968,27 @@ SweetGPUUserClient::surfaceBuffer(struct sweet_surface_request *req)
 	req->pixelFormat = surface->pixelFormat;
 	req->planes = surface->planeCount;
 	req->pad = 0;
