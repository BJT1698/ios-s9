+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -353,6 +353,16 @@ struct sweet_surface_request_v0 {
 #define SWEET_GPU_IMPORT_MAX            (64u << 20)     /* no surface of ours is bigger (828x1792x4 = 5.7 MiB) */
 #define SWEET_GPU_IMPORT_LOG_ALL        96u             /* every 0x7e result is logged up to this many lines, */
 #define SWEET_GPU_IMPORT_LOG_EVERY      256u            /* ... then one in this many (failures: one in 16) */
+/*
+ * 0113: pad of the 48-byte answer. SWEET_GPU_PLANE0 = the surface has planes and offset/rowBytes
