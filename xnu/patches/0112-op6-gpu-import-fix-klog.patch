+/*
+ * 0112: the layout sweet-drm (op6/mesa/sweet-drm/xf86drm.h, struct sweet_drm_surface) used up
+ * to G4d, 40 bytes: offset is 32 bits there. Answered in that layout, so an older libOSMesa
+ * works too. Before 0112 the kernel wrote its 48-byte layout over this one: rowBytes landed in
+ * width, width in height, height in pixel_format and pixelFormat in planes, so Mesa saw a
+ * surface of pixel format 1792 with 'BGRA' planes and never asked for the import
+ * (SweetGPUImports = 0, "0 drawn in place").
+ */
+struct sweet_surface_request_v0 {
+	uint32_t surface;
+	uint32_t handle;
+	uint64_t size;
+	uint32_t offset;
+	uint32_t rowBytes;
+	uint32_t width;
+	uint32_t height;
+	uint32_t pixelFormat;
+	uint32_t planes;
