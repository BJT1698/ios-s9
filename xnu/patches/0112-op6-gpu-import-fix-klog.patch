+/*
+ * One line per selector 0x7e result (0112): "SWEET GPU: import <process> surface N ...". All of
+ * them for the first SWEET_GPU_IMPORT_LOG_ALL lines, then one success in SWEET_GPU_IMPORT_LOG_EVERY
+ * and one failure in 16 (the counters have the rest). Called with no lock held.
+ */
+static void
+sweet_gpu_import_log(const char *proc, bool failed, const char *fmt, ...) __attribute__((format(printf, 3, 4)));
+static void
+sweet_gpu_import_log(const char *proc, bool failed, const char *fmt, ...)
+{
+	uint64_t n = SWEET_STAT_ADD(gStatImportLogs, 1);
+	char line[192];
+	va_list ap;
+
+	if (n >= SWEET_GPU_IMPORT_LOG_ALL &&
+	    (n % (failed ? 16u : SWEET_GPU_IMPORT_LOG_EVERY)) != 0) {
+		return;
+	}
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	IOLog("SWEET GPU: import %s %s (#%llu, imports %llu, refused %llu, %llu KB mapped)\n", proc, line, n + 1,
+	    SWEET_STAT_LOAD(gStatImports), SWEET_STAT_LOAD(gStatImportFails), SWEET_STAT_LOAD(gStatImportedBytes) >> 10);
+}
