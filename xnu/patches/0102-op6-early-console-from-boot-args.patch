diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 0fc4220..58da33a 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,16 +11,33 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+#include <pexpert/arm64/boot.h>
+
+/*
+ * The 32MB block start.s (VA=PA) and arm_vm_init (kernel alias) map
+ * Normal-NC for this console. Only rows below the block end are drawn.
+ */
+#define EARLY_BLOCK_PA  0x9c000000ULL
+#define EARLY_BLOCK_END (EARLY_BLOCK_PA + 0x2000000ULL)
+
+/* start.s draws its stage-0 band from these boot_args offsets. */
+_Static_assert(__builtin_offsetof(boot_args, Video.v_baseAddr) == 40, "start.s stage 0");
+_Static_assert(__builtin_offsetof(boot_args, Video.v_rowBytes) == 56, "start.s stage 0");
+_Static_assert(__builtin_offsetof(boot_args, Video.v_height) == 72, "start.s stage 0");
+
 /*
- * Galaxy S9: splash at 0x9d400000, 1440x2960, stride 5760, 20MB into the
- * 32MB block start.s/arm_vm_init map. Only rows below the block end
- * (0x9e000000) are mapped: (0x9e000000 - 0x9d400000) / 5760 = 2184.
+ * Galaxy S9 defaults: splash at 0x9d400000, 1440x2960, stride 5760, 20MB
+ * into the block: (0x9e000000 - 0x9d400000) / 5760 = 2184 rows mapped.
+ * sweet_early_set_video() replaces them with the boot_args geometry
+ * (OnePlus 6: 1080x2280, stride 4320, all rows inside the block).
  */
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9d400000;
+static uint64_t early_pa = 0x9d400000ULL;
+static unsigned int early_width = 1440u, early_height = 2184u, early_stride = 5760u / 4;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1440u
-#define EARLY_HEIGHT 2184u
-#define EARLY_STRIDE (5760u / 4)
+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -99,7 +116,7 @@ sweet_early_mark(unsigned int stage, const char *label)
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48 && x < EARLY_WIDTH; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
 		}
 	}
@@ -130,11 +147,41 @@ sweet_early_panic(const char *fmt, va_list *args)
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+/*
+ * arm_init, before the first mark: take the framebuffer geometry from
+ * boot_args instead of the Galaxy S9 constants. A framebuffer outside the
+ * mapped block (or nonsense) turns the early console off: nothing drawn
+ * beats stray writes.
+ */
+void
+sweet_early_set_video(uint64_t base, uint64_t width, uint64_t height, uint64_t row_bytes)
+{
+	if (base < EARLY_BLOCK_PA || base >= EARLY_BLOCK_END || (base & 3) || (row_bytes & 3) ||
+	    width < 64 || width > 8192 || row_bytes < width * 4) {
+		early_disabled = 1;
+		return;
+	}
+	uint64_t rows = (EARLY_BLOCK_END - base) / row_bytes;
+	if (height > rows) {
+		height = rows;
+	}
+	if (height < 64) {
+		early_disabled = 1;
+		return;
+	}
+	early_pa = base;
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	early_stride = (unsigned int)(row_bytes / 4);
+}
+
+/* base: kernel VA of the whole 32MB block (arm_vm_init's alias). */
 void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_fb = (volatile uint32_t *)(uintptr_t)(base + (early_pa - EARLY_BLOCK_PA));
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
