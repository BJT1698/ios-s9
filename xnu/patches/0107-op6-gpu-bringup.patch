+/* ---- primitives ---- */
+
+static inline uint32_t
+rd32(vm_offset_t a)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(a) : "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"(a) : "memory");
+}
+
+static inline uint64_t
+rd64(vm_offset_t a)
+{
+	uint64_t v;
+	__asm__ volatile ("ldr %0, [%1]" : "=r"(v) : "r"(a) : "memory");
+	return v;
+}
+
+static inline void
+dsb(void)
+{
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+/* Normal-NC loads may be reordered: index before payload (the shim's Device view was ordered). */
+static inline void
+dmb_ld(void)
+{
+	__asm__ volatile ("dmb ld" : : : "memory");
+}
+
+static void
+wr(vm_offset_t a, uint32_t v)
+{
+	wr32(a, v);
+	dsb();
+}
+
+static void
+wr64(vm_offset_t a, uint64_t v)
+{
+	__asm__ volatile ("str %0, [%1]" : : "r"(v), "r"(a) : "memory");
+	dsb();
+}
+
+static uint64_t
+us_now(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static void
+ms_wait(unsigned ms)
+{
+	delay((int)(ms * 1000));
+}
+
+/* Busy-poll until (rd & mask) == want or ms elapse; *us = time taken. */
+static int
+waitfor(vm_offset_t a, uint32_t mask, uint32_t want, unsigned ms, uint32_t *us)
+{
+	uint64_t t0 = us_now(), lim = (uint64_t)ms * 1000;
+	int ok;
+
+	for (;;) {
+		ok = (rd32(a) & mask) == want;
+		if (ok || us_now() - t0 > lim) {
+			break;
+		}
+	}
+	if (us) {
+		*us = (uint32_t)(us_now() - t0);
+	}
+	return ok;
+}
+
+/* Write, read back, refuse (0) when the masked bits differ. */
+static int
+wrv(const char *what, vm_offset_t a, uint32_t v, uint32_t mask)
+{
+	uint32_t got;
+
+	wr(a, v);
+	got = rd32(a);
+	if ((got & mask) == (v & mask)) {
+		return 1;
+	}
+	LOG("REFUSED %s w=%08x r=%08x\n", what, v, got);
+	return 0;
+}
+
+static void
+zero(vm_offset_t va, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i += 8) {
+		*(volatile uint64_t *)(va + i) = 0;
+	}
+}
+
+/* 4K-aligned piece of the carve-out (Normal NC). */
+static vm_offset_t
+dma_get(uint32_t size, uint64_t *pa)
+{
+	size = (size + 0xfffu) & ~0xfffu;
+	if (size > g.dma_size - g.dma_used) {
+		return 0;
+	}
+	vm_offset_t va = g.dma_va + g.dma_used;
+	*pa = g.dma_pa + g.dma_used;
+	g.dma_used += size;
+	zero(va, size);
+	return va;
+}
+
+static vm_offset_t
+dma_va(uint64_t pa)
+{
+	return g.dma_va + (vm_offset_t)(pa - g.dma_pa);
+}
+
+static uint32_t
+fw32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+	memcpy(&v, p + off, 4);
+	return v;
+}
+
+/* ---- 1. cmd-db (read only) and perf votes ---- */
+
+struct arc {
+	uint32_t addr;
+	int n;
+	uint16_t lvl[16];
+};
+static struct arc arc_cx, arc_mx, arc_gfx;
+
+static uint16_t
+db16(uint32_t off)
+{
+	return (uint16_t)(rd32(g.cmddb + (off & ~3u)) >> (8u * (off & 3u)));
+}
+
+static int
+db_range(uint32_t off, uint32_t size)
+{
+	return off <= LEN_CMDDB && size <= LEN_CMDDB - off;
+}
+
+/* cmd-db entry by name (slaves 3..5): address + aux data (ARC hardware levels). */
+static int
+arc_read(const char *res, struct arc *a)
+{
+	uint32_t key[2] = { 0, 0 };
+
+	for (unsigned i = 0; i < 8 && res[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8 * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8 + 16 * i;
+		unsigned slave = db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = 144u + db16(h + 2), data = 144u + db16(h + 4);
+		unsigned count = db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3) || !db_range(entries, count * 24u)) {
+			return -1;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + 24u * j;
+			if (rd32(g.cmddb + e) != key[0] || rd32(g.cmddb + e + 4) != key[1]) {
+				continue;
+			}
+			unsigned len = db16(e + 20), off = db16(e + 22), n = len / 2;
+			a->addr = rd32(g.cmddb + e + 16);
+			if (!db_range(data + off, len)) {
+				return -2;
+			}
+			if (n > 16) {
+				n = 16;
+			}
+			for (unsigned k = 0; k < n; k++) {
+				a->lvl[k] = db16(data + off + 2 * k);
+			}
+			return (int)n;
+		}
+	}
+	return -3;
+}
+
+/* a6xx_gmu_rpmh_arc_votes_init for one OPP level. */
+static uint32_t
+arc_vote(const struct arc *pri, unsigned level, int *ok)
+{
+	int pi = -1, si = 0;
+
+	for (int j = 0; j < pri->n; j++) {
+		if (pri->lvl[j] >= level) {
+			pi = j;
+			break;
+		}
+	}
+	if (pi < 0) {
+		*ok = 0;
+		return 0;
+	}
+	for (int j = 0; j < arc_mx.n; j++) {
+		if (arc_mx.lvl[j] >= level) {
+			si = j;
+			break;
+		} else if (arc_mx.lvl[j]) {
+			si = j;
+		}
+	}
+	return ((uint32_t)pri->lvl[pi] << 16) | ((uint32_t)si << 8) | (uint32_t)pi;
+}
+
+static const uint32_t gpu_khz[8] = { 0, 257000, 342000, 414000, 520000, 596000, 675000, 710000 };
+static const uint16_t gpu_lvl[8] = { 0, 0x40, 0x80, 0xc0, 0x100, 0x140, 0x180, 0x1a0 };
+static const uint32_t gmu_khz[3] = { 0, 200000, 400000 };
+static const uint16_t gmu_lvl[3] = { 0, 0x30, 0x80 };
+static uint32_t gx_vote[8], cx_vote[3];
+
+static int
+votes(void)
+{
+	int ok = 1;
+
+	if (rd32(g.cmddb + 4) != 0x0c0330dbu) {
+		LOG("cmd-db magic %08x at 0x%lx: stopping\n", rd32(g.cmddb + 4), PA_CMDDB);
+		return 0;
+	}
+	arc_cx.n = arc_read("cx.lvl", &arc_cx);
+	arc_mx.n = arc_read("mx.lvl", &arc_mx);
+	arc_gfx.n = arc_read("gfx.lvl", &arc_gfx);
+	LOG("cmd-db cx.lvl @%05x n=%d, mx.lvl @%05x n=%d, gfx.lvl @%05x n=%d\n",
+	    arc_cx.addr, arc_cx.n, arc_mx.addr, arc_mx.n, arc_gfx.addr, arc_gfx.n);
+	if (arc_cx.n <= 0 || arc_mx.n <= 0 || arc_gfx.n <= 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		gx_vote[i] = arc_vote(&arc_gfx, gpu_lvl[i], &ok);
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		cx_vote[i] = arc_vote(&arc_cx, gmu_lvl[i], &ok);
+	}
+	LOG("votes gx %06x %06x %06x %06x %06x %06x %06x %06x cx %06x %06x %06x\n",
+	    gx_vote[0], gx_vote[1], gx_vote[2], gx_vote[3], gx_vote[4], gx_vote[5], gx_vote[6],
+	    gx_vote[7], cx_vote[0], cx_vote[1], cx_vote[2]);
+	if (!ok) {
+		LOG("an OPP level has no ARC level in cmd-db: stopping\n");
+	}
+	return ok;
+}
+
+/* ---- 1b. CX GDSC + GMU clocks (200 MHz) ---- */
+
+static int
+branch_on(vm_offset_t cbcr)
+{
+	wr(cbcr, rd32(cbcr) | CBCR_ENABLE);
+	return waitfor(cbcr, CBCR_OFF, 0, 200, NULL);
+}
+
+static int
+power_on(void)
+{
+	LOG("1 power: GPLL0 vote, gcc cfg_ahb, CX GDSC\n");
+	wr(GCC(GCC_GPLL0_VOTE), rd32(GCC(GCC_GPLL0_VOTE)) | (1u << 15) | (1u << 16));
+	if (!branch_on(GCC(GCC_GPU_CFG_AHB))) {
+		LOG("gcc gpu_cfg_ahb does not turn on: stopping\n");
+		return 0;
+	}
+	uint32_t v = rd32(GPUCC(GPUCC_CX_GDSCR));
+	if (v & SW_COLLAPSE) {
+		wr(GPUCC(GPUCC_CX_GDSCR), v & ~SW_COLLAPSE);
+	}
+	int cx = 0;
+	for (int i = 0; i < 2000 && !cx; i++) {
+		cx = (rd32(GPUCC(GPUCC_CX_GDSCR)) & PWR_ON) || (rd32(GPUCC(GPUCC_CX_HW_CTRL)) & PWR_ON);
+		if (!cx) {
+			ms_wait(1);
+		}
+	}
+	LOG("CX gdscr=%08x hw=%08x%s\n", rd32(GPUCC(GPUCC_CX_GDSCR)), rd32(GPUCC(GPUCC_CX_HW_CTRL)),
+	    cx ? "" : " NOT ON");
+	if (!cx) {
+		return 0;
+	}
+	LOG("1 power: GMU RCG 200 MHz + branches\n");
+	wr(GPUCC(GPUCC_GMU_CFG_RCGR), GMU_RCG_200MHZ);
+	wr(GPUCC(GPUCC_GMU_CMD_RCGR), rd32(GPUCC(GPUCC_GMU_CMD_RCGR)) | 1u);
+	(void)waitfor(GPUCC(GPUCC_GMU_CMD_RCGR), 1u, 0, 200, NULL);
+	wr(GPUCC(GPUCC_CX_GMU_CBCR), rd32(GPUCC(GPUCC_CX_GMU_CBCR)) | CX_GMU_WAKE_SLEEP);
+	(void)branch_on(GPUCC(GPUCC_CXO_CBCR));
+	(void)branch_on(GPUCC(GPUCC_AHB_CBCR));
+	int gmu = branch_on(GPUCC(GPUCC_CX_GMU_CBCR));
+	(void)branch_on(GCC(GCC_GPU_MEMNOC_GFX));
+	(void)branch_on(GCC(GCC_DDRSS_GPU_AXI));
+	(void)branch_on(GCC(GCC_GPU_SNOC_DVM));
+	LOG("CLK rcg=%04x cxo=%08x ahb=%08x gmu=%08x memnoc=%08x axi=%08x dvm=%08x\n",
+	    rd32(GPUCC(GPUCC_GMU_CFG_RCGR)), rd32(GPUCC(GPUCC_CXO_CBCR)), rd32(GPUCC(GPUCC_AHB_CBCR)),
+	    rd32(GPUCC(GPUCC_CX_GMU_CBCR)), rd32(GCC(GCC_GPU_MEMNOC_GFX)), rd32(GCC(GCC_DDRSS_GPU_AXI)),
+	    rd32(GCC(GCC_GPU_SNOC_DVM)));
+	if (!gmu) {
+		LOG("gpu_cc_cx_gmu_clk does not turn on: stopping\n");
+	}
+	return gmu;
+}
+
+/* ---- 2. GPU SMMU ---- */
+
+static uint32_t pgsz = 0x1000, npage = 8, ncb, nsmr, idr0;
+static int cb = -1, gcb = -1;		/* GMU / GPU context banks */
+static uint32_t cbbase, gcbbase;
+
+struct pt {
+	uint64_t root_pa;
+	uint64_t pool_pa;
+	unsigned used;
+};
+static struct pt gmu_pt, gpu_pt;
+
+static uint64_t
+pt_new(struct pt *t)
+{
+	if (t->used >= 3) {
+		return 0;
+	}
+	uint64_t pa = t->pool_pa + 4096ull * t->used++;
+	zero(dma_va(pa), 4096);
+	return pa;
+}
+
+/* io-pgtable-arm stage 1, 4K granule, 39-bit: one PTE per 4K GPU page. */
+static int
+pt_map(struct pt *t, uint64_t va, uint64_t pa, uint32_t size, uint64_t attr)
+{
+	for (uint32_t off = 0; off < size; off += 4096) {
+		uint64_t v = va + off, tpa = t->root_pa;
+		for (int shift = 30; shift >= 21; shift -= 9) {
+			volatile uint64_t *e = (volatile uint64_t *)dma_va(tpa) + ((v >> shift) & 0x1ff);
+			if (!(*e & 1)) {
+				uint64_t n = pt_new(t);
+				if (!n) {
+					return 0;
+				}
+				*e = n | PTE_TABLE;
+			}
+			tpa = *e & PTE_ADDR;
+		}
+		((volatile uint64_t *)dma_va(tpa))[(v >> 12) & 0x1ff] = (pa + off) | attr;
+	}
+	dsb();
+	return 1;
+}
+
+static int
+smmu_probe(void)
+{
+	uint32_t idr1, busy = 0, used = 0;
+
+	idr0 = rd32(SMMU(S_IDR0));
+	idr1 = rd32(SMMU(S_IDR1));
+	nsmr = idr0 & 0xff;
+	ncb = idr1 & 0xff;
+	pgsz = (idr1 >> 31) ? 0x10000 : 0x1000;
+	npage = 2u << ((idr1 >> 28) & 7);
+	LOG("2 SMMU idr0=%08x idr1=%08x cr0=%08x smr=%u cb=%u pg=%uK n=%u\n", idr0, idr1,
+	    rd32(SMMU(S_CR0)), nsmr, ncb, pgsz >> 10, npage);
+	if (2 * npage * pgsz != LEN_SMMU || ncb == 0 || ncb > 32 || nsmr > 128) {
+		LOG("SMMU layout does not match 0x10000: stopping\n");
+		return 0;
+	}
+	for (uint32_t n = 0; n < nsmr && (idr0 & IDR0_SMS); n++) {
+		uint32_t smr = rd32(SMMU(S_SMR(n))), s2cr = rd32(SMMU(S_S2CR(n)));
+		if ((smr & SMR_VALID)) {
+			used++;
+			if (((s2cr >> 16) & 3) == 0) {
+				busy |= 1u << (s2cr & 0x1f);
+			}
+			LOG("smr%u=%08x s2cr=%08x (already there)\n", n, smr, s2cr);
+		}
+	}
+	for (uint32_t i = 0; i < ncb; i++) {
+		if (rd32(SMMU(npage * pgsz + i * pgsz + CB_SCTLR)) & 1) {
+			busy |= 1u << i;
+		}
+	}
+	/* arm-smmu-qcom: the GPU gets the first free bank (CB 0 on a clean SMMU), the GMU the next */
+	gcb = cb = -1;
+	for (uint32_t i = 0; i < ncb && gcb < 0; i++) {
+		if (!(busy & (1u << i))) {
+			gcb = (int)i;
+		}
+	}
+	for (uint32_t i = 0; i < ncb && cb < 0; i++) {
+		if (!(busy & (1u << i)) && (int)i != gcb) {
+			cb = (int)i;
+		}
+	}
+	LOG("smr valid=%u cb busy=%02x -> gpu cb%d gmu cb%d\n", used, busy, gcb, cb);
+	return gcb >= 0 && cb >= 0;
+}
+
+static int
+smr_slot(uint32_t sid, int avoid)
+{
+	if (!(idr0 & IDR0_SMS)) {
+		return sid < 128 ? (int)sid : -1;
+	}
+	for (uint32_t n = 0; n < nsmr; n++) {
+		if ((rd32(SMMU(S_SMR(n))) & (SMR_VALID | 0x7fff)) == (SMR_VALID | sid)) {
+			return (int)n;
+		}
+	}
+	for (uint32_t n = 0; n < nsmr; n++) {
+		if (!(rd32(SMMU(S_SMR(n))) & SMR_VALID) && (int)n != avoid) {
+			return (int)n;
+		}
+	}
+	return -1;
+}
+
+static int
+smmu_route(uint32_t sid, int bank, int avoid)
+{
+	int n = smr_slot(sid, avoid);
+
+	if (n < 0) {
+		LOG("no free SMR for sid %u\n", sid);
+		return -1;
+	}
+	wr(SMMU(S_S2CR(n)), (uint32_t)bank);
+	if (idr0 & IDR0_SMS) {
+		wr(SMMU(S_SMR(n)), SMR_VALID | sid);
+	}
+	LOG("sid %u smr%d=%08x s2cr=%08x\n", sid, n, rd32(SMMU(S_SMR(n))), rd32(SMMU(S_S2CR(n))));
+	return (rd32(SMMU(S_S2CR(n))) & 0x300ff) == (uint32_t)bank &&
+	       (!(idr0 & IDR0_SMS) || rd32(SMMU(S_SMR(n))) == (SMR_VALID | sid)) ? n : -1;
+}
+
+static int
+cb_faulted(const char *when, uint32_t base)
+{
+	vm_offset_t c = SMMU(base);
+	uint32_t fsr, gfsr;
+
+	if (!base) {
+		return 0;
+	}
+	fsr = rd32(c + CB_FSR);
+	gfsr = rd32(SMMU(S_GFSR));
+	if (!(fsr & FSR_ALL) && !gfsr) {
+		return 0;
+	}
+	LOG("FAULT %s fsr=%08x far=%llx syn=%08x gfsr=%08x gsyn0=%08x gsyn1(sid)=%08x\n", when, fsr,
+	    rd64(c + CB_FAR), rd32(c + CB_FSYNR0), gfsr, rd32(SMMU(S_GFSYNR0)), rd32(SMMU(S_GFSYNR1)));
+	return 1;
+}
+
+static int
+faulted(const char *when)
+{
+	return cb_faulted(when, cbbase) | cb_faulted(when, gcbbase);
+}
+
+static void
+tlb_sync_global(void)
+{
+	wr(SMMU(S_TLBIALLNSNH), 0);
+	wr(SMMU(S_TLBGSYNC), 0);
+	(void)waitfor(SMMU(S_TLBGSTATUS), 1, 0, 100, NULL);
+}
+
+/* One S1 context bank (VMID 0, VA64, 39-bit, 4K, walks NC). 1 = it took the writes. */
+static int
+cb_setup(int bank, uint64_t root_pa, uint32_t extra_sctlr, uint32_t *base)
+{
+	uint32_t off = npage * pgsz + (uint32_t)bank * pgsz;
+	vm_offset_t c = SMMU(off);
+	uint64_t ttbr = root_pa | ((uint64_t)(uint32_t)bank << 48);
+
+	wr(c + CB_SCTLR, 0);
+	wr(SMMU(pgsz + S_CBA2R(bank)), 1);
+	wr(SMMU(pgsz + S_CBAR(bank)), CBAR_S1);
+	wr(c + CB_TCR2, TCR2_VAL);
+	wr(c + CB_TCR, TCR_VAL);
+	wr(c + CB_TTBR0, (uint32_t)ttbr);
+	wr(c + CB_TTBR0 + 4, (uint32_t)(ttbr >> 32));
+	wr(c + CB_TTBR1, 0);
+	wr(c + CB_TTBR1 + 4, 0);
+	wr(c + CB_MAIR0, MAIR0_VAL);
+	wr(c + CB_MAIR1, 0);
+	wr(c + CB_FSR, FSR_ALL);
+	wr(c + CB_TLBIALL, 0);
+	wr(c + CB_TLBSYNC, 0);
+	(void)waitfor(c + CB_TLBSTATUS, 1, 0, 100, NULL);
+	wr(c + CB_SCTLR, SCTLR_ON | extra_sctlr);
+	LOG("cb%d cbar=%08x sctlr=%04x ttbr0=%08x tcr=%08x\n", bank, rd32(SMMU(pgsz + S_CBAR(bank))),
+	    rd32(c + CB_SCTLR), rd32(c + CB_TTBR0), rd32(c + CB_TCR));
+	if (!(rd32(c + CB_SCTLR) & 1) || rd32(c + CB_TTBR0) != (uint32_t)ttbr ||
+	    ((rd32(SMMU(pgsz + S_CBAR(bank))) >> 16) & 3) != 1) {
+		LOG("context bank %d did NOT take the writes: stopping\n", bank);
+		return 0;
+	}
+	*base = off;
+	return 1;
+}
+
+static uint64_t
+ats(uint32_t base, uint32_t va)
+{
+	vm_offset_t c = SMMU(base);
+
+	wr64(c + CB_ATS1PR, va);
+	(void)waitfor(c + CB_ATSR, 1, 0, 100, NULL);
+	return rd64(c + CB_PAR);
+}
+
+static int
+have_ats(void)
+{
+	return (idr0 & IDR0_S1TS) && !(idr0 & IDR0_ATOSNS);
+}
+
+/* GMU memory (a6xx_gmu_memory_probe, legacy) */
+static vm_offset_t mem_hfi;
+static uint64_t pa_hfi, pa_dummy, pa_debug, pa_log;
+
+static int
+smmu_gmu(void)
+{
+	LOG("2 SMMU: GMU tables + context + SID 5/4\n");
+	if (!dma_get(0x1000, &pa_dummy) || !dma_get(0x4000, &pa_debug) || !dma_get(0x4000, &pa_log) ||
+	    !(mem_hfi = dma_get(0x4000, &pa_hfi)) || !dma_get(3 * 4096, &gmu_pt.pool_pa)) {
+		LOG("carve-out too small\n");
+		return 0;
+	}
+	gmu_pt.used = 0;
+	gmu_pt.root_pa = pt_new(&gmu_pt);
+	if (!pt_map(&gmu_pt, VA_DUMMY, pa_dummy, 0x1000, PTE_RW) ||
+	    !pt_map(&gmu_pt, VA_DEBUG, pa_debug, 0x4000, PTE_RW) ||
+	    !pt_map(&gmu_pt, VA_LOG, pa_log, 0x4000, PTE_RW) ||
+	    !pt_map(&gmu_pt, VA_HFI, pa_hfi, 0x4000, PTE_RW)) {
+		LOG("no GMU tables\n");
+		return 0;
+	}
+	LOG("hfi pa=%llx ttbr=%llx\n", pa_hfi, gmu_pt.root_pa);
+	if (!cb_setup(cb, gmu_pt.root_pa, 0, &cbbase)) {
+		return 0;
+	}
+	int s5 = smmu_route(SID_GMU, cb, -1);
+	if (s5 < 0) {
+		LOG("sid 5 rule did not stick: stopping\n");
+		return 0;
+	}
+	if (smmu_route(SID_GMU_USER, cb, s5) < 0) {
+		LOG("sid 4 rule did not stick (continuing: the DT only uses 5)\n");
+	}
+	tlb_sync_global();
+	uint32_t cr0 = rd32(SMMU(S_CR0));
+	if (cr0 & S_CR0_CLIENTPD) {
+		wr(SMMU(S_CR0), cr0 & ~S_CR0_CLIENTPD);
+	}
+	LOG("sCR0 %08x -> %08x\n", cr0, rd32(SMMU(S_CR0)));
+	if (rd32(SMMU(S_CR0)) & S_CR0_CLIENTPD) {
+		LOG("SMMU still in bypass (CLIENTPD): stopping\n");
+		return 0;
+	}
+	if (have_ats()) {
+		uint64_t par = ats(cbbase, VA_HFI);
+		LOG("ATS 0x60009000 -> par=%016llx\n", par);
+		if ((par & 1) || (par & 0xfffffff000ull) != pa_hfi) {
+			LOG("the SMMU does not translate to the HFI buffer: stopping\n");
+			(void)faulted("ats");
+			return 0;
+		}
+	}
+	return !faulted("before boot");
+}
+
+/* ---- 3. GMU firmware + boot ---- */
+
+static void
+rpmh_ucode(void)
+{
+	static const uint32_t rsc_seq[5] = { 0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u };
+	static const uint32_t pdc_seq[5] = { 0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu };
+	static const uint32_t tcs_addr[3] = { 0x30010, 0x30000, GPU_PDC_CMD2 };
+	static const uint32_t tcs1_data[3] = { 1, 0, 0 };
+	static const uint32_t tcs3_data[3] = { 2, 3, 3 };
+
+	wr32(RSCC(0x004), 1u << 24);
+	wr32(RSCC(0x00b), 1);
+	wr32(RSCC(0x00e), 0);
+	wr32(RSCC(0x00d), 0);
+	wr32(RSCC(0x00e + 2), 0);
+	wr32(RSCC(0x00d + 2), 0);
+	wr32(RSCC(0x00e + 4), 0x80000000u);
+	wr32(RSCC(0x00d + 4), 0);
+	wr32(RSCC(0x100), 0);
+	wr32(RSCC(0x008), 0x4520);
+	wr32(RSCC(0x009), 0x4510);
+	wr32(RSCC(0x00a), 0x4514);
+	for (unsigned i = 0; i < 5; i++) {
+		wr32(RSCC(0x180 + i), rsc_seq[i]);
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		wr32(PDCSEQ(i), pdc_seq[i]);
+	}
+	for (unsigned t = 0; t < 2; t++) {
+		uint32_t ctl = t ? 0x15d6 : 0x1572;
+		const uint32_t *d = t ? tcs3_data : tcs1_data;
+		wr32(PDC(ctl + 1), 7);
+		wr32(PDC(ctl + 2), 0);
+		wr32(PDC(ctl), 0);
+		for (unsigned c = 0; c < 3; c++) {
+			wr32(PDC(ctl + 3 + 4 * c), 0x10108);
+			wr32(PDC(ctl + 4 + 4 * c), tcs_addr[c]);
+			wr32(PDC(ctl + 5 + 4 * c), d[c]);
+		}
+	}
+	wr32(PDC(0x1148), 0);
+	wr32(PDC(0x1140), 0x80000001u);
+	dsb();
+}
+
+static void
+gmu_halt(void)
+{
+	wr(GMU(GMU_CM3_SYSRESET), 1);
+}
+
+static int
+gmu_boot(void)
+{
+	unsigned words = g.fw_gmu_len / 4, wrong = 0;
+	uint32_t result = 0, dtcm_ver, mask = 0xffffffffu, want = GMU_BABEFACE;
+
+	LOG("3 GMU: CM3 reset, RSC/PDC micro-code, %u words into ITCM\n", words);
+	wr(GMU(GMU_CM3_SYSRESET), 1);
+	wr(GMU(GMU_GENERAL_7), 1);
+	rpmh_ucode();
+	for (unsigned i = 0; i < words; i++) {
+		wr32(GMU(GMU_CM3_ITCM_START + i), fw32(g.fw_gmu, 4 * i));
+	}
+	dsb();
+	for (unsigned i = 0; i < words; i++) {
+		wrong += rd32(GMU(GMU_CM3_ITCM_START + i)) != fw32(g.fw_gmu, 4 * i);
+	}
+	LOG("FW words=%u wrong=%u w0=%08x\n", words, wrong, fw32(g.fw_gmu, 0));
+	if (wrong) {
+		return 0;
+	}
+	wr32(GMU(GMU_CM3_FW_INIT_RESULT), 0);
+	wr32(GMU(GMU_CM3_BOOT_CONFIG), 2);
+	wr32(GMU(GMU_HFI_QTBL_ADDR), VA_HFI);
+	wr32(GMU(GMU_HFI_QTBL_INFO), 1);
+	wr32(GMU(GMU_AHB_FENCE_RANGE_0), FENCE_RANGE);
+	wr32(GMU(GMU_CM3_CFG), 0x4052);
+	wr32(GMU(GMU_HFI_SFR_ADDR), GMU_CHIPID);
+	wr32(GMU(GMU_PWR_COL_CP_MSG), VA_LOG | (0x4000 / 4096 - 1));
+	wr32(GMU(GMU_SYS_BUS_CONFIG), 1);
+	wr32(GMU(GMU_ICACHE_CONFIG), 1);
+	wr32(GMU(GMU_DCACHE_CONFIG), 1);
+	wr32(GMU(GMU_PWR_COL_INTER_FRAME_CTRL), 0x9c40400u);
+	wr32(GMU(GMU_RPMH_CTRL), RPMH_CTRL_LINUX);
+	wr32(GMU(GMU_CX_GMU_WFI_CONFIG), 0);
+	wr32(GMU(GMU_GMU2HOST_INTR_CLR), 0xffffffffu);
+	wr32(GMU(GMU_GMU2HOST_INTR_MASK), ~INTR_MSGQ);
+	dsb();
+	if (rd32(GMU(GMU_RPMH_CTRL)) != RPMH_CTRL_LINUX) {
+		LOG("GMU_RPMH_CTRL refused: %08x\n", rd32(GMU(GMU_RPMH_CTRL)));
+		return 0;
+	}
+	dtcm_ver = rd32(GMU(GMU_CM3_DTCM_START + 0xff8));
+	if (dtcm_ver > 0x20010004u) {
+		mask = 0x1ff;
+		want = 0x100;
+	}
+	LOG("3 GMU: release the CM3, wait for 0xBABEFACE\n");
+	wr(GMU(GMU_CM3_SYSRESET), 1);
+	wr(GMU(GMU_PWR_COL_CP_RESP), 0);
+	wr(GMU(GMU_CM3_SYSRESET), 0);
+	for (int i = 0; i < 1000; i++) {
+		result = rd32(GMU(GMU_CM3_FW_INIT_RESULT));
+		if ((result & mask) == want) {
+			break;
+		}
+		ms_wait(1);
+	}
+	LOG("GMU init=%08x dtcm[ff8]=%08x pwr=%02x rpmh_ctrl=%08x\n", result, dtcm_ver,
+	    rd32(GMU(GMU_RPMH_POWER_STATE)), rd32(GMU(GMU_RPMH_CTRL)));
+	return (result & mask) == want;
+}
+
+/* ---- 4. HFI v1 ---- */
+
+static volatile uint32_t *
+qhdr(unsigned q)
+{
+	return (volatile uint32_t *)mem_hfi + 6 + 12 * q;
+}
+
+static volatile uint32_t *
+qdata(unsigned q)
+{
+	return (volatile uint32_t *)(mem_hfi + 0x1000 * (q + 1));
+}
+
+static void
+hfi_table(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)mem_hfi;
+
+	t[0] = 0;
+	t[1] = 24 + 2 * 48;
+	t[2] = 6;
+	t[3] = 12;
+	t[4] = 2;
+	t[5] = 2;
+	for (unsigned q = 0; q < 2; q++) {
+		volatile uint32_t *h = qhdr(q);
+		h[QH_IOVA] = VA_HFI + 0x1000 * (q + 1);
+		h[QH_TYPE] = (10u << 8) | (q ? 4u : 0u);
+		h[QH_STATUS] = 1;
+		h[QH_SIZE] = Q_WORDS;
+		h[QH_RXWM] = 1;
+		h[QH_TXWM] = 1;
+		h[QH_RXREQ] = 1;
+	}
+	dsb();
+}
+
+static uint32_t seqnum, ack_payload0, gmu_fw_version;
+
+static int
+hfi_send(const char *what, uint32_t id, uint32_t *msg, uint32_t words)
+{
+	volatile uint32_t *h = qhdr(0), *q = qdata(0), *rh = qhdr(1), *rq = qdata(1);
+	uint32_t seq = ++seqnum % 0xfff, w = h[QH_WRITE], r = h[QH_READ];
+	int verdict = -1;
+
+	if ((r + Q_WORDS - w - 1) % Q_WORDS < words) {
+		LOG("HFI %s: command queue full\n", what);
+		return -1;
+	}
+	msg[0] = (seq << 20) | (words << 8) | id;
+	for (uint32_t i = 0; i < words; i++) {
+		q[w] = msg[i];
+		w = (w + 1) % Q_WORDS;
+	}
+	h[QH_WRITE] = w;
+	dsb();
+	wr(GMU(GMU_HOST2GMU_INTR_SET), 1);
+	for (int t = 0; t < 1000 && verdict < 0; t++) {
+		if (!(rd32(GMU(GMU_GMU2HOST_INTR_INFO)) & INTR_MSGQ)) {
+			if (faulted(what)) {
+				break;
+			}
+			ms_wait(1);
+			continue;
+		}
+		wr(GMU(GMU_GMU2HOST_INTR_CLR), INTR_MSGQ);
+		while (rh[QH_READ] != rh[QH_WRITE]) {
+			dmb_ld();
+			uint32_t at = rh[QH_READ] % Q_WORDS, m[20], n = (rq[at] >> 8) & 0xff;
+			if (n == 0 || n > 19) {
+				LOG("HFI %s: corrupt reply hdr=%08x\n", what, rq[at]);
+				rh[QH_READ] = rh[QH_WRITE];
+				break;
+			}
+			for (uint32_t i = 0; i < n; i++) {
+				m[i] = rq[at];
+				at = (at + 1) % Q_WORDS;
+			}
+			rh[QH_READ] = at;
+			dsb();
+			if ((m[0] & 0xff) == F2H_ERROR) {
+				LOG("HFI %s: F2H_MSG_ERROR code=%u\n", what, m[1]);
+				continue;
+			}
+			if ((m[0] & 0xff) == F2H_ACK && n >= 3 && ((m[1] >> 20) & 0xfff) == seq) {
+				verdict = (int)m[2];
+				ack_payload0 = n >= 4 ? m[3] : 0;
+			}
+		}
+	}
+	LOG("HFI %s: %s %d seq=%u\n", what, verdict < 0 ? "NO REPLY" : verdict ? "REFUSED err" : "ACK ok",
+	    verdict, seq);
+	return verdict < 0 ? -1 : verdict;
+}
+
+static int
+hfi_talk(void)
+{
+	static uint32_t msg[160];
+
+	wr(GMU(GMU_HFI_CTRL_INIT), 1);
+	int up = waitfor(GMU(GMU_HFI_CTRL_STATUS), 1, 1, 100, NULL);
+	LOG("HFI status=%08x ver=%08x\n", rd32(GMU(GMU_HFI_CTRL_STATUS)), rd32(GMU(GMU_HFI_VERSION_INFO)));
+	if (!up) {
+		(void)faulted("ctrl_init");
+		return 0;
+	}
+	bzero(msg, sizeof(msg));
+	msg[2] = VA_DEBUG;
+	msg[3] = 0x4000;
+	msg[4] = 1;
+	if (hfi_send("INIT", MSG_INIT, msg, 5)) {
+		return 0;
+	}
+	bzero(msg, sizeof(msg));
+	msg[1] = (1u << 28) | (1u << 19) | (1u << 17);
+	if (hfi_send("FW_VERSION", MSG_FW_VERSION, msg, 2)) {
+		return 0;
+	}
+	gmu_fw_version = ack_payload0;
+	LOG("GMU fw version %08x\n", gmu_fw_version);
+	bzero(msg, sizeof(msg));
+	msg[1] = 8;
+	msg[2] = 3;
+	for (unsigned i = 0; i < 8; i++) {
+		msg[3 + 2 * i] = gx_vote[i];
+		msg[4 + 2 * i] = gpu_khz[i];
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		msg[35 + 2 * i] = cx_vote[i];
+		msg[36 + 2 * i] = gmu_khz[i];
+	}
+	if (hfi_send("PERF_TABLE", MSG_PERF_TABLE, msg, 43)) {
+		return 0;
+	}
+	bzero(msg, sizeof(msg));
+	msg[1] = 1;
+	msg[2] = 3;
+	msg[3] = 3;
+	msg[4] = 0x05;
+	msg[5] = 0x07;
+	msg[6] = 0x50034;
+	msg[7] = 0x5007c;
+	msg[8] = 0x5004c;
+	msg[12] = 0x40000000;
+	msg[14] = 0x40000000;
+	msg[18] = 0x60000001;
+	msg[19] = 0x20000001;
+	msg[20] = 0x60000001;
+	msg[24] = 0x50000;
+	msg[25] = 0x5005c;
+	msg[26] = 0x5000c;
+	msg[32] = 0x40000000;
+	msg[33] = 0x40000000;
+	msg[34] = 0x40000000;
+	if (hfi_send("BW_TABLE", MSG_BW_TABLE, msg, 160)) {
+		return 0;
+	}
+	bzero(msg, sizeof(msg));
+	(void)hfi_send("TEST", MSG_TEST, msg, 1);
+	return 1;
+}
+
+/* ---- 4b. GX through the GMU (legacy a630) ---- */
+
+static int booted, gx_boot, set_tried, gpu_set, gx_on;
+
+static int
+oob_set(const char *name, unsigned req, unsigned ack)
+{
+	uint32_t us;
+
+	if (rd32(GMU(GMU_GMU2HOST_INTR_INFO)) & (1u << ack)) {
+		wr(GMU(GMU_GMU2HOST_INTR_CLR), 1u << ack);
+	}
+	wr(GMU(GMU_HOST2GMU_INTR_SET), 1u << req);
+	int ok = waitfor(GMU(GMU_GMU2HOST_INTR_INFO), 1u << ack, 1u << ack, OOB_MS, &us);
+	uint32_t info = rd32(GMU(GMU_GMU2HOST_INTR_INFO));
+	wr(GMU(GMU_GMU2HOST_INTR_CLR), 1u << ack);
+	LOG("OOB %s %s %uus i=%08x p=%02x\n", name, ok ? "ack" : "NO ACK", us, info,
+	    rd32(GMU(GMU_RPMH_POWER_STATE)));
+	return ok;
+}
+
+static void
+oob_clear(unsigned bit)
+{
+	wr(GMU(GMU_HOST2GMU_INTR_SET), 1u << bit);
+}
+
+static int
+gx_state(const char *label)
+{
+	uint32_t cf = rd32(GPUCC(GPUCC_GX_CFG)), sp = rd32(GMU(GMU_SPTPRAC_STATUS));
+
+	LOG("%s gd=%08x cf=%08x sp=%02x p=%02x busy=%08x\n", label, rd32(GPUCC(GPUCC_GX_GDSCR)), cf, sp,
+	    rd32(GMU(GMU_RPMH_POWER_STATE)), rd32(GMU(GMU_CX_BUSY_STATUS)));
+	return (cf & GDSC_UP) && !(sp & SPT_GX_OFF);
+}
+
+static int
+gx_rail_on(void)
+{
+	uint32_t v = gx_vote[OPP_BOOT], us;
+
+	LOG("4 GX: vote %u MHz gx=%u mx=%u lvl=%03x, OOB BOOT_SLUMBER\n", gpu_khz[OPP_BOOT] / 1000,
+	    v & 0xff, (v >> 8) & 0xff, v >> 16);
+	if (!wrv("slumber_opt", GMU(GMU_BOOT_SLUMBER_OPTION), 0, ~0u) ||
+	    !wrv("gx_vote_idx", GMU(GMU_GX_VOTE_IDX), v & 0xff, ~0u) ||
+	    !wrv("mx_vote_idx", GMU(GMU_MX_VOTE_IDX), (v >> 8) & 0xff, ~0u)) {
+		return 0;
+	}
+	gx_boot = oob_set("BOOT", OOB_BOOT_SET, OOB_BOOT_ACK);
+	(void)gx_state("GX");
+	if (!gx_boot) {
+		return 0;
+	}
+	wr(GMU(GMU_SPTPRAC_CTRL), 0x778000u);
+	int ok = waitfor(GMU(GMU_SPTPRAC_STATUS), 0x38, 0x28, 20, &us);
+	LOG("SPTPRAC st=%02x %s\n", rd32(GMU(GMU_SPTPRAC_STATUS)), ok ? "on" : "NOT on (Linux continues)");
+	return 1;
+}
+
+static void
+dcvs(void)
+{
+	if (!wrv("dcvs_ack", GMU(GMU_DCVS_ACK_OPTION), 0, ~0u) ||
+	    !wrv("dcvs_perf", GMU(GMU_DCVS_PERF_SETTING), (3u << 28) | OPP_BOOT, ~0u) ||
+	    !wrv("dcvs_bw", GMU(GMU_DCVS_BW_SETTING), 0xff, ~0u)) {
+		return;
+	}
+	(void)oob_set("DCVS", OOB_DCVS_SET, OOB_DCVS_ACK);
+	oob_clear(OOB_DCVS_ACK);
+	LOG("DCVS return=%08x\n", rd32(GMU(GMU_DCVS_RETURN)));
+}
+
+/* ---- 7. shutdown (a6xx_gmu_shutdown, legacy; the shim's M12 drop()) ---- */
+
+static void
+sptprac_off(void)
+{
+	(void)wrv("gx_retain", GPUCC(GPUCC_GX_GDSCR), rd32(GPUCC(GPUCC_GX_GDSCR)) | GDSC_RETAIN_FF, GDSC_RETAIN_FF);
+	wr(GMU(GMU_SPTPRAC_CTRL), 0x778001u);
+	(void)waitfor(GMU(GMU_SPTPRAC_STATUS), SPT_PWR_OFF, SPT_PWR_OFF, 10, NULL);
+}
+
+static void
+hfi_stop_masks(void)
+{
+	for (unsigned q = 0; q < 2 && mem_hfi; q++) {
+		qhdr(q)[QH_READ] = 0;
+		qhdr(q)[QH_WRITE] = 0;
+	}
+	dsb();
+	wr(GMU(GMU_AO_HOST_INTR_MASK), ~0u);
+	wr(GMU(GMU_GMU2HOST_INTR_MASK), ~0u);
+}
+
+static void
+gx_gdsc_off(void)
+{
+	if (!(rd32(GPUCC(GPUCC_GX_CFG)) & GDSC_UP)) {
+		(void)gx_state("GX end");
+		return;
+	}
+	wr(GPUCC(GPUCC_GX_GDSCR), rd32(GPUCC(GPUCC_GX_GDSCR)) | SW_COLLAPSE);
+	int ok = waitfor(GPUCC(GPUCC_GX_CFG), GDSC_DOWN, GDSC_DOWN, 100, NULL);
+	if (ok) {
+		(void)wrv("gx_clamp", GPUCC(GPUCC_GX_CLAMP), rd32(GPUCC(GPUCC_GX_CLAMP)) | 1, 1);
+	}
+	LOG("GX end: GDSC %s by the CPU gd=%08x\n", ok ? "off" : "NOT off", rd32(GPUCC(GPUCC_GX_GDSCR)));
+}
+
+static void
+drop(void)
+{
+	if (!booted) {
+		return;
+	}
+	LOG("7 shutdown: OOB clear, VBIF halt, slumber, CM3 reset\n");
+	if (set_tried) {
+		if (gpu_set) {
+			oob_clear(OOB_GPU_ACK);
+		}
+		oob_clear(OOB_BOOT_ACK);
+	}
+	if (gx_boot && rd32(GMU(GMU_RPMH_POWER_STATE)) != PWR_SLUMBER) {
+		int slept = 0;
+		if (waitfor(GMU(GMU_RPMH_POWER_STATE), ~0u, 0, 100, NULL)) {
+			if (gx_on) {
+				if (wrv("vbif_halt0", GPU(VBIF_XIN_HALT_CTRL0), 0xf, 0xf)) {
+					int ok = waitfor(GPU(VBIF_XIN_HALT_CTRL1), 0xf, 0xf, 100, NULL);
+					(void)wrv("vbif_halt0", GPU(VBIF_XIN_HALT_CTRL0), 0, 0xf);
+					LOG("VBIF halt %s\n", ok ? "ack, released" : "NO ack (continuing)");
+				}
+			}
+			(void)wrv("pwr_counter", GMU(GMU_POWER_COUNTER_EN), 0, ~0u);
+			sptprac_off();
+			int ok = wrv("slumber_opt", GMU(GMU_BOOT_SLUMBER_OPTION), 1, ~0u) &&
+			    oob_set("SLUMBER", OOB_BOOT_SET, OOB_BOOT_ACK);
+			oob_clear(OOB_BOOT_ACK);
+			slept = ok && rd32(GMU(GMU_RPMH_POWER_STATE)) == PWR_SLUMBER;
+			(void)wrv("fence_allow", GMU(GMU_AO_FENCE_CTRL), 0, ~0u);
+		}
+		if (!slept) {
+			LOG("force_off (GMU not idle / no slumber)\n");
+			wr(GMU(GMU_PWR_COL_KEEPALIVE), 0);
+			hfi_stop_masks();
+			sptprac_off();
+			wr(GMU(GMU_FENCE_STATUS_CLR), 7);
+			wr(GMU(GMU_AO_FENCE_CTRL), 0);
+		} else {
+			int quiet = waitfor(GMU(GMU_CX_BUSY_STATUS), CX_BUSY_GPU, 0, 10, NULL);
+			LOG("slumber ok (0xf)%s\n", quiet ? ", GPU idle" : ", CX still busy");
+			hfi_stop_masks();
+		}
+	} else {
+		hfi_stop_masks();
+	}
+	gx_gdsc_off();
+	(void)faulted("end");
+	gmu_halt();
+	booted = 0;
+}
+
+/* ---- 5. zap via TZ ---- */
+
+static uint64_t scm_r1;
+
+static int
+scm(const char *label, int fast, uint32_t svc, uint32_t cmd, uint32_t arginfo,
+    uint64_t a, uint64_t b, uint64_t c, int want_a1_nonzero)
+{
+	uint64_t fn = (fast ? 1ull << 31 : 0) | (1u << 30) | SCM_OWNER_SIP | (svc << 8) | cmd;
+	uint64_t x0 = fn, x6 = 0, r0, r1;
+	unsigned spins = 0, busy = 0;
+	uint64_t t0 = us_now();
+
+	for (;;) {
+		register uint64_t q0 __asm__("x0") = x0;
+		register uint64_t q1 __asm__("x1") = arginfo;
+		register uint64_t q2 __asm__("x2") = a;
+		register uint64_t q3 __asm__("x3") = b;
+		register uint64_t q4 __asm__("x4") = c;
+		register uint64_t q5 __asm__("x5") = 0;
+		register uint64_t q6 __asm__("x6") = x6;
+		register uint64_t q7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0"
+                    : "+r"(q0), "+r"(q1), "+r"(q2), "+r"(q3), "+r"(q4), "+r"(q5), "+r"(q6), "+r"(q7)
+                    :
+                    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+		r0 = q0;
+		r1 = q1;
+		if (r0 == SCM_INTERRUPTED && spins < 1000000) {
+			x0 = SCM_INTERRUPTED;
+			x6 = q6;
+			spins++;
+			continue;
+		}
+		if (r0 == SCM_EBUSY && busy < 20) {
+			busy++;
+			ms_wait(30);
+			x0 = fn;
+			x6 = 0;
+			continue;
+		}
+		break;
+	}
+	scm_r1 = r1;
+	int ok = r0 == 0 && (want_a1_nonzero ? r1 != 0 : r1 == 0);
+	LOG("SCM %s x0=%08llx -> a0=%08x a1=%08x i=%u b=%u %lluus %s\n", label, fn, (uint32_t)r0,
+	    (uint32_t)r1, spins, busy, us_now() - t0, ok ? "ok" : "REFUSED");
+	return ok ? 0 : -1;
+}
+
+struct seg {
+	uint32_t off, pa, fsz, msz, fl;
+};
+
+static uint32_t
+zw(uint32_t off)
+{
+	return fw32(g.fw_zap, off);
+}
+
+static struct seg
+zseg(uint32_t i)
+{
+	uint32_t o = zw(28) + 32 * i;
+	struct seg s = { zw(o + 4), zw(o + 12), zw(o + 16), zw(o + 20), zw(o + 24) };
+	return s;
+}
+
+static int
+seg_valid(const struct seg *s, uint32_t type)
+{
+	return type == PT_LOAD && (s->fl & MDT_TYPE_MASK) != MDT_TYPE_HASH && s->msz;
+}
+
+static int
+zap_load(void)
+{
+	uint32_t fsize = g.fw_zap_len, phnum, hash = 0, lo = ~0u, hi = 0, reloc = 0, nload = 0;
+
+	LOG("5 zap: a630_zap.mbn %u bytes\n", fsize);
+	if (fsize < 52 || zw(0) != 0x464c457fu || (zw(4) & 0xffff) != 0x0101 || zw(28) != 52 ||
+	    (zw(40) >> 16) != 32) {
+		LOG("zap is not ELF32 LE with phdrs at 52: stopping\n");
+		return 0;
+	}
+	phnum = zw(44) & 0xffff;
+	if (phnum < 2 || phnum > 16 || 52 + 32 * phnum > fsize || zw(52) == PT_LOAD) {
+		LOG("zap phdrs unexpected\n");
+		return 0;
+	}
+	for (uint32_t i = 1; i < phnum && !hash; i++) {
+		if ((zseg(i).fl & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			hash = i;
+		}
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		struct seg s = zseg(i);
+		if (!seg_valid(&s, zw(52 + 32 * i))) {
+			continue;
+		}
+		nload++;
+		if (s.fl & MDT_RELOC) {
+			reloc = 1;
+		}
+		if (s.pa < lo) {
+			lo = s.pa;
+		}
+		if (s.pa + s.msz > hi) {
+			hi = (s.pa + s.msz + 0xfffu) & ~0xfffu;
+		}
+	}
+	uint32_t size = lo < hi ? hi - lo : 0;
+	LOG("ZAP n=%u hash=%u load=%u %s size=%x/%x\n", phnum, hash, nload, reloc ? "rel" : "abs", size, ZAP_SIZE);
+	if (!hash || !size || size > ZAP_SIZE) {
+		return 0;
+	}
+	struct seg h = zseg(hash);
+	uint32_t ehsz = zseg(0).fsz, hoff;
+	if (ehsz > fsize || h.fsz > fsize || h.off > fsize) {
+		hoff = ~0u;
+	} else if (ehsz + h.fsz == fsize) {
+		hoff = ehsz;
+	} else if (h.off + h.fsz <= fsize) {
+		hoff = h.off;
+	} else {
+		hoff = ~0u;
+	}
+	uint64_t meta_pa = 0;
+	vm_offset_t meta = (hoff != ~0u && ehsz + h.fsz <= 0x2000) ? dma_get(0x2000, &meta_pa) : 0;
+	if (!meta || ((ehsz | h.fsz | hoff) & 3)) {
+		LOG("zap metadata outside the file/buffer: stopping\n");
+		return 0;
+	}
+	for (uint32_t i = 0; i < ehsz; i += 4) {
+		*(volatile uint32_t *)(meta + i) = zw(i);
+	}
+	for (uint32_t i = 0; i < h.fsz; i += 4) {
+		*(volatile uint32_t *)(meta + ehsz + i) = zw(hoff + i);
+	}
+	dsb();
+	LOG("ZAP meta %x pa=%llx\n", ehsz + h.fsz, meta_pa);
+	uint32_t reloc_base = reloc ? lo : (uint32_t)ZAP_PHYS;
+	for (uint32_t i = 0; i < phnum; i++) {
+		struct seg s = zseg(i);
+		if (!seg_valid(&s, zw(52 + 32 * i))) {
+			continue;
+		}
+		uint32_t off = s.pa - reloc_base;
+		if (s.pa < reloc_base || off > size || s.msz > size - off || s.fsz > s.msz ||
+		    s.off > fsize || s.fsz > fsize - s.off ||
+		    ((off | s.fsz | s.msz | s.off) & 3)) {
+			LOG("zap segment outside region/file: stopping\n");
+			return 0;
+		}
+	}
+	if (scm("conv", 1, SVC_INFO, INFO_CALL_AVAIL, 1, SCM_OWNER_SIP | (SVC_INFO << 8) | INFO_CALL_AVAIL,
+	    0, 0, 1) || scm_r1 != 1) {
+		LOG("TZ does not answer SMC64 SIP: stopping\n");
+		return 0;
+	}
+	if (!scm("avail", 0, SVC_INFO, INFO_CALL_AVAIL, 1, SCM_OWNER_SIP | (SVC_PIL << 8) | PIL_SUPPORTED, 0, 0, 1)) {
+		(void)scm("sup13 (info only, 0 on this firmware)", 0, SVC_PIL, PIL_SUPPORTED, 1, PAS_GPU, 0, 0, 1);
+	}
+	if (scm("init_image", 0, SVC_PIL, PIL_INIT_IMAGE, 2 | (SCM_ARG_RW << 6), PAS_GPU, meta_pa, 0, 0)) {
+		return 0;
+	}
+	if (reloc && scm("mem_setup", 0, SVC_PIL, PIL_MEM_SETUP, 3, PAS_GPU, ZAP_PHYS, size, 0)) {
+		return 0;
+	}
+	uint32_t bad = 0, bytes = 0;
+	for (uint32_t i = 0; i < phnum; i++) {
+		struct seg s = zseg(i);
+		if (!seg_valid(&s, zw(52 + 32 * i))) {
+			continue;
+		}
+		vm_offset_t dst = g.zap + (s.pa - reloc_base);
+		for (uint32_t k = 0; k < s.msz; k += 4) {
+			wr32(dst + k, k < s.fsz ? zw(s.off + k) : 0);
+		}
+		dsb();
+		for (uint32_t k = 0; k < s.msz; k += 4) {
+			bad += rd32(dst + k) != (k < s.fsz ? zw(s.off + k) : 0);
+		}
+		bytes += s.msz;
+	}
+	LOG("ZAP copied %x bytes to 0x%lx, wrong=%u\n", bytes, ZAP_PHYS, bad);
+	if (bad || scm("auth_and_reset", 0, SVC_PIL, PIL_AUTH_RESET, 1, PAS_GPU, 0, 0, 0)) {
+		return 0;
+	}
+	LOG("ZAP accepted by TrustZone (PAS 13)\n");
+	return 1;
+}
+
+/* ---- 6. CP ---- */
+
+static vm_offset_t ring, scratch;
+static uint64_t pa_sqe, pa_ring, pa_scratch;
+static uint32_t wp;
+
+static uint32_t
+gr(uint32_t n)
+{
+	return rd32(GPU(n));
+}
+
+static const uint32_t hw_init_regs[][2] = {
+	{ 0xf803, 0 }, { 0xf800, 0 }, { 0xf801, 0 }, { 0xf802, 0 },
+	{ 0x0842, 1 }, { 0x0c01, 1 }, { 0x8601, 1 }, { 0x8e05, 1 },
+	{ 0x9e01, 1 }, { 0xbe05, 1 }, { 0xa601, 1 }, { 0x9601, 1 },
+	{ 0x0e00, 1 }, { 0xae01, 1 }, { 0xb601, 1 }, { 0xf810, 1 },
+	{ 0x0010, 3 }, { 0x302a, 9 },
+	{ 0x0e05, 0xffffffc0u }, { 0x0e06, 0x0001ffffu },
+	{ 0x0e09, 0xfffff000u }, { 0x0e0a, 0x0001ffffu },
+	{ 0x0e07, 0xfffff000u }, { 0x0e08, 0x0001ffffu },
+	{ 0x0e0b, 0x00100000u }, { 0x0e0c, 0 },
+	{ 0x0e0d, 0x001fffffu }, { 0x0e0e, 0 },
+	{ 0x0e18, 0x804 }, { 0x0e17, 0x4 },
+	{ 0x08c2, 0x010000c0u }, { 0x08c1, 0x8040362cu }, { 0x08c3, 128 },
+	{ 0x9e00, 0x00180000u }, { 0x098d, 0x1 },
+	{ 0x8e08, 2u << 1 }, { 0xb604, 2u << 1 }, { 0xae02, 2u << 1 }, { 0x0e01, 2u << 21 },
+	{ 0x001f, (1u << 30) | 0x1fffffu }, { 0x0e19, 1 },
+};
+
+static int
+cp_prepare(void)
+{
+	uint32_t words = g.fw_sqe_len / 4 - 1, ver = fw32(g.fw_sqe, 4);
+	vm_offset_t sqe;
+
+	LOG("6 CP: SQE %u words ver=%03x, GPU context (SID 0)\n", words, ver & 0xfff);
+	int patched = (ver & 0xf) == 0xa && (fw32(g.fw_sqe, 12) & 0xf) >= 1;
+	if (!patched && (ver & 0xfff) < 0x190) {
+		LOG("SQE version < 0x190 (Linux refuses): stopping\n");
+		return 0;
+	}
+	if (!(sqe = dma_get(9 * 1024 * 4, &pa_sqe)) || words * 4 > 9 * 1024 * 4 ||
+	    !(ring = dma_get(RING_DW * 4, &pa_ring)) || !(scratch = dma_get(4096, &pa_scratch)) ||
+	    !dma_get(3 * 4096, &gpu_pt.pool_pa)) {
+		LOG("carve-out too small\n");
+		return 0;
+	}
+	uint32_t bad = 0;
+	for (uint32_t i = 0; i < words; i++) {
+		((volatile uint32_t *)sqe)[i] = fw32(g.fw_sqe, 4 * (i + 1));
+	}
+	dsb();
+	for (uint32_t i = 0; i < words; i++) {
+		bad += ((volatile uint32_t *)sqe)[i] != fw32(g.fw_sqe, 4 * (i + 1));
+	}
+	LOG("SQE pa=%llx wrong=%u\n", pa_sqe, bad);
+	if (bad) {
+		return 0;
+	}
+	gpu_pt.used = 0;
+	gpu_pt.root_pa = pt_new(&gpu_pt);
+	if (!pt_map(&gpu_pt, VA_SQE, pa_sqe, 9 * 1024 * 4, PTE_RW | PTE_RDONLY) ||
+	    !pt_map(&gpu_pt, VA_RING, pa_ring, RING_DW * 4, PTE_RW) ||
+	    !pt_map(&gpu_pt, VA_SCRATCH, pa_scratch, 4096, PTE_RW)) {
+		LOG("no GPU tables\n");
+		return 0;
+	}
+	if (rd32(SMMU(npage * pgsz + (uint32_t)gcb * pgsz + CB_SCTLR)) & 1) {
+		LOG("GPU context bank already enabled by someone: stopping\n");
+		return 0;
+	}
+	if (!cb_setup(gcb, gpu_pt.root_pa, SCTLR_HUPCF, &gcbbase)) {
+		return 0;
+	}
+	int n = smmu_route(SID_GPU, gcb, -1);
+	if (n < 0) {
+		LOG("sid 0 rule did not stick: stopping\n");
+		return 0;
+	}
+	tlb_sync_global();
+	uint32_t cr0 = rd32(SMMU(S_CR0));
+	int s4 = smr_slot(SID_GMU_USER, -1);
+	int both = smr_slot(SID_GMU, -1) >= 0 && s4 >= 0 && (rd32(SMMU(S_SMR(s4))) & SMR_VALID);
+	if (!(cr0 & S_CR0_USFCFG) && both) {
+		wr(SMMU(S_CR0), cr0 | S_CR0_USFCFG);
+	}
+	LOG("sCR0 %08x -> %08x\n", cr0, rd32(SMMU(S_CR0)));
+	if ((both && !(rd32(SMMU(S_CR0)) & S_CR0_USFCFG)) || (rd32(SMMU(S_CR0)) & S_CR0_CLIENTPD)) {
+		return 0;
+	}
+	if (have_ats()) {
+		uint64_t pr = ats(gcbbase, VA_RING), ps = ats(gcbbase, VA_SQE + 0x8000);
+		LOG("ATS ring %llx sqe+8000 %llx\n", pr, ps);
+		if ((pr & 1) || (pr & 0xfffffff000ull) != pa_ring ||
+		    (ps & 1) || (ps & 0xfffffff000ull) != pa_sqe + 0x8000) {
+			(void)faulted("ats");
+			return 0;
+		}
+	}
+	wr(SMMU(gcbbase + CB_FSR), FSR_ALL);
+	wr(SMMU(S_GFSR), rd32(SMMU(S_GFSR)));
+
+	uint32_t diff = 0, cnt = sizeof(hw_init_regs) / sizeof(hw_init_regs[0]);
+	for (uint32_t i = 0; i < cnt; i++) {
+		uint32_t r = hw_init_regs[i][0], v = hw_init_regs[i][1];
+		wr(GPU(r), v);
+		if (r < 0xf000 && gr(r) != v) {
+			diff++;
+		}
+	}
+	LOG("hw_init writes=%u differ=%u prot=%08x st=%08x\n", cnt, diff, gr(CP_PROTECT_CNTL), gr(RBBM_STATUS));
+	return gr(0x0842) == 1;
+}
+
+static uint32_t
+par4(uint32_t v)
+{
+	v ^= v >> 16;
+	v ^= v >> 8;
+	v ^= v >> 4;
+	return (0x9669u >> (v & 0xf)) & 1;
+}
+
+static void
+emit(uint32_t v)
+{
+	((volatile uint32_t *)ring)[wp++] = v;
+}
+
+static void
+pkt7(uint32_t op, uint32_t cnt)
+{
+	emit(0x70000000u | cnt | (par4(cnt) << 15) | ((op & 0x7f) << 16) | (par4(op) << 23));
+}
+
+static void
+flush(void)
+{
+	pkt7(CP_WHERE_AM_I, 2);
+	emit(VA_SCRATCH + 4 * SCR_SHADOW);
+	emit(0);
+	dsb();
+	wr(GPU(CP_RB_WPTR), wp);
+}
+
+static int
+cp_idle(const char *label, unsigned ms)
+{
+	uint64_t t0 = us_now();
+	uint32_t r, sh, st, i0;
+	int ok;
+
+	for (;;) {
+		r = gr(CP_RB_RPTR);
+		sh = ((volatile uint32_t *)scratch)[SCR_SHADOW];
+		st = gr(RBBM_STATUS);
+		i0 = gr(RBBM_INT_0_STATUS);
+		ok = r == wp && sh == wp && !(st & ~RBBM_STATUS_CXMASTER) && !(i0 & INT0_HANG);
+		if (ok || us_now() - t0 > (uint64_t)ms * 1000) {
+			break;
+		}
+	}
+	LOG("%s rptr=%u shadow=%u wptr=%u st=%08x %lluus %s\n", label, r, sh, wp, st, us_now() - t0,
+	    ok ? "ok" : "TIMEOUT");
+	if (!ok) {
+		LOG("%s flt=%08x ci=%08x pr=%08x i0=%08x st1=%08x\n", label, gr(CP_HW_FAULT),
+		    gr(CP_INTERRUPT_STATUS), gr(CP_PROTECT_STATUS), i0, gr(CP_STATUS_1));
+	}
+	(void)faulted(label);
+	return ok;
+}
+
+static int
+cp_run(uint32_t *magic)
+{
+	wp = 0;
+	if (!wrv("sqe_base", GPU(CP_SQE_INSTR_BASE), VA_SQE, ~0u) ||
+	    !wrv("sqe_base_hi", GPU(CP_SQE_INSTR_BASE + 1), 0, ~0u) ||
+	    !wrv("rb_base", GPU(CP_RB_BASE), VA_RING, ~0u) ||
+	    !wrv("rb_base_hi", GPU(CP_RB_BASE + 1), 0, ~0u) ||
+	    !wrv("rb_cntl", GPU(CP_RB_CNTL), RB_CNTL_VAL, 0x08003f3fu) ||
+	    !wrv("rptr_addr", GPU(CP_RB_RPTR_ADDR), VA_SCRATCH + 4 * SCR_SHADOW, ~0u) ||
+	    !wrv("rptr_addr_hi", GPU(CP_RB_RPTR_ADDR + 1), 0, ~0u)) {
+		return 0;
+	}
+	if (gr(CP_RB_RPTR) || gr(CP_RB_WPTR)) {
+		LOG("ring pointers not zero (rptr=%u wptr=%u): stopping\n", gr(CP_RB_RPTR), gr(CP_RB_WPTR));
+		return 0;
+	}
+	LOG("6 CP: CP_SQE_CNTL=1, CP_ME_INIT\n");
+	wr(GPU(CP_SQE_CNTL), 1);
+	pkt7(CP_ME_INIT, 8);
+	emit(0x0000002f);
+	emit(0x00000003);
+	emit(0x20000000);
+	emit(0);
+	emit(0);
+	emit(0);
+	emit(0);
+	emit(0);
+	flush();
+	if (!cp_idle("ME_INIT", 500)) {
+		return 0;
+	}
+	pkt7(CP_SET_SECURE_MODE, 1);
+	emit(0);
+	flush();
+	if (!cp_idle("SECURE0", 500)) {
+		return 0;
+	}
+	LOG("6 CP: CP_NOP + CP_MEM_WRITE 0x%08x -> GPU VA 0x%08x\n", MAGIC, VA_SCRATCH + 4 * SCR_MAGIC);
+	pkt7(CP_NOP, 1);
+	emit(0x4f503633u);
+	pkt7(CP_MEM_WRITE, 3);
+	emit(VA_SCRATCH + 4 * SCR_MAGIC);
+	emit(0);
+	emit(MAGIC);
+	flush();
+	int idle = cp_idle("MEMWRITE", 500);
+	uint64_t t0 = us_now();
+	uint32_t v;
+	while ((v = ((volatile uint32_t *)scratch)[SCR_MAGIC]) != MAGIC && us_now() - t0 <= 100000) {
+	}
+	*magic = v;
+	LOG("MEM value=%08x +%lluus va=%08x pa=%llx%s\n", v, us_now() - t0, VA_SCRATCH + 4 * SCR_MAGIC,
+	    pa_scratch + 4 * SCR_MAGIC, idle ? "" : " (CP not idle)");
+	return v == MAGIC;
+}
+
+/* ---- setup: ADT firmware + carve-out, mappings ---- */
+
+static int
+adt_fw(DTEntry e, const char *name, const uint8_t **p, uint32_t *len, uint32_t min, uint32_t max)
+{
+	void const *prop = NULL;
+	unsigned int size = 0;
+
+	if (SecureDTGetProperty(e, name, &prop, &size) != kSuccess || size < min || size > max || (size & 3)) {
+		LOG("ADT /sweet-gpu %s missing or bad size (%u)\n", name, size);
+		return 0;
+	}
+	*p = prop;
+	*len = size;
+	return 1;
+}
+
+static int
+setup(void)
+{
+	DTEntry e;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	uint64_t region[2];
+
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &e) != kSuccess) {
+		LOG("no ADT /sweet-gpu (mkadt-op6.py --gpu-fw DIR): stopping\n");
+		return 0;
+	}
+	if (!adt_fw(e, "gmu-firmware", &g.fw_gmu, &g.fw_gmu_len, 0x1000, 0x8000) ||
+	    !adt_fw(e, "sqe-firmware", &g.fw_sqe, &g.fw_sqe_len, 0x1000, 9 * 1024 * 4 + 4) ||
+	    !adt_fw(e, "zap-firmware", &g.fw_zap, &g.fw_zap_len, 0x100, 0x10000)) {
+		return 0;
+	}
+	if (SecureDTGetProperty(e, "dma-region", &prop, &size) != kSuccess || size != sizeof(region)) {
+		LOG("ADT /sweet-gpu dma-region missing\n");
+		return 0;
+	}
+	memcpy(region, prop, sizeof(region));
+	if ((region[0] & 0xffff) || region[1] < 0x100000 || region[1] > 0x10000000 ||
+	    region[0] + region[1] > (1ull << 36)) {
+		LOG("dma-region %llx+%llx refused\n", region[0], region[1]);
+		return 0;
+	}
+	LOG("firmware from ADT: gmu %u, sqe %u, zap %u bytes; carve-out %llx+%llx\n", g.fw_gmu_len,
+	    g.fw_sqe_len, g.fw_zap_len, region[0], region[1]);
+	g.gcc = ml_io_map(PA_GCC, LEN_GCC);
+	g.gpucc = ml_io_map(PA_GPUCC, LEN_GPUCC);
+	g.gmu = ml_io_map(PA_GMU, LEN_GMU);
+	g.pdc = ml_io_map(PA_PDC, LEN_PDC);
+	g.pdcseq = ml_io_map(PA_PDCSEQ, LEN_PDC);
+	g.smmu = ml_io_map(PA_SMMU, LEN_SMMU);
+	g.gpu = ml_io_map(PA_GPU, LEN_GPU);
+	g.cmddb = ml_io_map(PA_CMDDB, LEN_CMDDB);
+	g.zap = ml_io_map(ZAP_PHYS, ZAP_SIZE);
+	g.dma_va = ml_io_map_unmappable((vm_offset_t)region[0], (vm_size_t)region[1], SWEET_WIMG_WCOMB);
+	g.dma_pa = region[0];
+	g.dma_size = (uint32_t)region[1];
+	g.dma_used = 0;
+	if (!g.gcc || !g.gpucc || !g.gmu || !g.pdc || !g.pdcseq || !g.smmu || !g.gpu || !g.cmddb ||
+	    !g.zap || !g.dma_va) {
+		LOG("a mapping failed\n");
+		return 0;
+	}
+	if (rd32(GCC(GCC_GPU_CFG_AHB)) & CBCR_OFF) {
+		LOG("ABL state: gcc gpu_cfg_ahb off (gpucc not read before it is on)\n");
+	}
+	return 1;
+}
+
+int
+sweet_gpu_g1(int keep, struct sweet_gpu_result *res)
+{
+	uint32_t magic = 0;
+	int ok = 0;
+
+	bzero(res, sizeof(*res));
+	LOG("G1 start (sweetgpu=%d: %s)\n", keep ? 2 : 1, keep ? "leave the GPU on" : "power down after the test");
+	res->stage = 0;
+	if (!setup()) {
+		return -1;
+	}
+	res->stage = 1;
+	if (!votes() || !power_on()) {
+		return -1;
+	}
+	res->stage = 2;
+	if (!smmu_probe() || !smmu_gmu()) {
+		return -1;
+	}
+	res->stage = 3;
+	hfi_table();
+	if (!gmu_boot()) {
+		(void)faulted("boot");
+		gmu_halt();
+		return -1;
+	}
+	booted = 1;
+	res->stage = 4;
+	if (!gx_rail_on() || !hfi_talk()) {
+		goto down;
+	}
+	res->gmu_fw_version = gmu_fw_version;
+	dcvs();
+	set_tried = 1;
+	gpu_set = oob_set("GPU_SET", OOB_GPU_SET, OOB_GPU_ACK);
+	gx_on = gx_state("GX") && gpu_set;
+	uint32_t st = gx_on ? gr(RBBM_STATUS) : 0xffffffffu;
+	LOG("RBBM st=%08x CP st1=%08x vbif=%08x\n", st, gx_on ? gr(CP_STATUS_1) : 0, gx_on ? gr(VBIF_VERSION) : 0);
+	if (gx_on) {
+		/* as the shim's probes(): the always-on counters over ~100 ms before the zap */
+		uint32_t a0 = rd32(GMU(GMU_AO_COUNTER_L)), c0 = gr(CP_ALWAYS_ON);
+		ms_wait(100);
+		LOG("AO gmu d=%u cp d=%u in ~100 ms (19.2 MHz = ~1920000)\n", rd32(GMU(GMU_AO_COUNTER_L)) - a0,
+		    gr(CP_ALWAYS_ON) - c0);
+	}
+	if (!gx_on || st == 0xffffffffu || faulted("GX")) {
+		LOG("GX not confirmed: no zap\n");
+		goto down;
+	}
+	res->stage = 5;
+	if (!zap_load()) {
+		goto down;
+	}
+	res->stage = 6;
+	res->sqe_version = fw32(g.fw_sqe, 4) & 0xfff;
+	if (cp_prepare() && cp_run(&magic)) {
+		ok = 1;
+	}
+	res->magic = magic;
+	(void)faulted("CP end");
+	LOG("CP end st=%08x rptr=%u\n", gr(RBBM_STATUS), gr(CP_RB_RPTR));
+down:
+	if (ok) {
+		res->stage = 7;
+		LOG("G1 OK: THE CP WROTE 0x%08x THROUGH THE GPU SMMU (pa %llx)\n", magic, pa_scratch + 4 * SCR_MAGIC);
+	} else {
+		LOG("G1 FAILED at stage %u\n", res->stage);
+	}
+	if (ok && keep) {
+		res->kept_on = 1;
+		LOG("GPU left on: GMU running, GX held by OOB GPU_SET, ring idle at wptr %u\n", wp);
+		return 0;
+	}
+	drop();
+	LOG("G1 done: GMU in reset, GX %s\n", (rd32(GPUCC(GPUCC_GX_CFG)) & GDSC_UP) ? "STILL ON" : "off");
+	return ok ? 0 : -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
new file mode 100644
index 0000000..acc7a1b
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -0,0 +1,123 @@
+/*
+ * SWEET: GPU service, OnePlus 6 (Adreno 630), milestone G1.
+ *
+ * Matched on IOResources like the other SWEET services (personality in
+ * iokit/KernelConfigTables.cpp). start() only proceeds on
+ * /chosen/sweet-board = "oneplus,enchilada" with boot-arg sweetgpu=1 or 2;
+ * otherwise it returns false and nothing touches the GPU. A kernel thread
+ * bound to cpu 0 then waits sweetgpudelay seconds (default 30: the
+ * persistent log and USB networking are up by then, so a hang still leaves
+ * a log) and runs the bring-up in bsd/dev/sweet_gpu.c. The result is
+ * published as properties of this service and the service is registered:
+ *
+ *   SweetGPUStage   last stage reached (7 = CP_MEM_WRITE landed)
+ *   SweetGPUMagic   the word read back (0xC0FFEE01 on success)
+ *   SweetGPUFirmware GMU firmware version (HFI), SQE version
+ *   SweetGPUState   "off" (sweetgpu=1, shut down after the test),
+ *                   "on" (sweetgpu=2, GPU left running), "failed"
+ *
+ * so `ioreg -l -c SweetGPU` over SSH shows it next to the kernel log. The
+ * user client (msm-uAPI subset for Mesa freedreno) is milestone G2.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+extern "C" {
+struct sweet_gpu_result {
+	uint32_t stage, magic, gmu_fw_version, sqe_version, kept_on;
+};
+int sweet_gpu_g1(int keep, struct sweet_gpu_result *res);       /* bsd/dev/sweet_gpu.c */
+int sweet_bind_current_thread(int cpu);                         /* osfmk/kern/sched_prim.c */
+void thread_set_thread_name(thread_t th, const char *name);     /* osfmk/kern/thread.c */
+kern_return_t thread_terminate(thread_t);                       /* Mach MIG, not in kern/thread.h */
+}
+
+class SweetGPU : public IOService {
+	OSDeclareDefaultStructors(SweetGPU);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+private:
+	static void bringup(void *arg, wait_result_t wr);
+	int fMode;
+	unsigned fDelay;
+};
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+static bool
+sweet_gpu_board_is(const char *want)
+{
+	DTEntry chosen;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	size_t n = strlen(want) + 1;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-board", &prop, &size) != kSuccess) {
+		return false;
+	}
+	return size >= n && memcmp(prop, want, n) == 0;
+}
+
+void
+SweetGPU::bringup(void *arg, wait_result_t wr)
+{
+	SweetGPU *self = (SweetGPU *)arg;
+	struct sweet_gpu_result r;
+	(void)wr;
+
+	thread_set_thread_name(current_thread(), "sweet.gpu");
+	IOLog("SWEET GPU: thread on cpu %d, starting in %u s\n", sweet_bind_current_thread(0), self->fDelay);
+	IOSleep(self->fDelay * 1000u);
+	int rc = sweet_gpu_g1(self->fMode == 2, &r);
+	self->setProperty("SweetGPUStage", (unsigned long long)r.stage, 32);
+	self->setProperty("SweetGPUMagic", (unsigned long long)r.magic, 32);
+	self->setProperty("SweetGPUFirmwareGMU", (unsigned long long)r.gmu_fw_version, 32);
+	self->setProperty("SweetGPUFirmwareSQE", (unsigned long long)r.sqe_version, 32);
+	self->setProperty("SweetGPUState", rc ? "failed" : r.kept_on ? "on" : "off");
+	self->registerService();
+	IOLog("SWEET GPU: service registered (stage %u, magic 0x%08x, %s)\n", r.stage, r.magic,
+	    rc ? "failed" : r.kept_on ? "GPU on" : "GPU off");
+	self->release();
+	(void)thread_terminate(current_thread());
+}
+
+bool
+SweetGPU::start(IOService *provider)
+{
+	thread_t th;
+
+	fMode = 0;
+	fDelay = 30;
+	(void)PE_parse_boot_argn("sweetgpu", &fMode, sizeof(fMode));
+	(void)PE_parse_boot_argn("sweetgpudelay", &fDelay, sizeof(fDelay));
+	if (fDelay > 3600) {
+		fDelay = 3600;
+	}
+	if (fMode != 1 && fMode != 2) {
+		return false;
+	}
+	if (!sweet_gpu_board_is("oneplus,enchilada")) {
+		IOLog("SWEET GPU: sweetgpu=%d ignored: not an OnePlus 6\n", fMode);
+		return false;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("SweetGPUState", "starting");
+	retain();
+	if (kernel_thread_start(&SweetGPU::bringup, this, &th) != KERN_SUCCESS) {
+		IOLog("SWEET GPU: no thread\n");
+		release();
+		return false;
+	}
+	thread_deallocate(th);
+	return true;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
