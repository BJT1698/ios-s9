diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 7182b44..d256b4d 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -143,6 +143,8 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 #define SP_IMEM_RESTART_REASON  0x65cu
 
 static int sweet_next_boot;
+static vm_offset_t sp_pon_chan, sp_imem;
+static uint16_t sp_pon_chan_apid = SP_NO_APID;
 
 static int
 sp_pon_read(uint16_t apid, unsigned reg, uint8_t *out)
@@ -188,7 +190,11 @@ sp_pon_set_reason(unsigned reason)
 	unsigned shift = (subtype == 0x08 || subtype == 0x09) ? 1 : 2;
 	uint8_t keep = (uint8_t)((1u << shift) - 1);
 	uint8_t value = (uint8_t)((spare & keep) | (reason << shift));
-	vm_offset_t chan = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x100);
+	if (!sp_pon_chan || sp_pon_chan_apid != apid) {
+		sp_pon_chan = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x100);
+		sp_pon_chan_apid = apid;
+	}
+	vm_offset_t chan = sp_pon_chan;
 	if (!chan) {
 		goto out;
 	}
@@ -206,7 +212,10 @@ sp_pon_set_reason(unsigned reason)
 	}
 	uint8_t check = 0;
 	(void)sp_pon_read(apid, SP_PON_SOFT_RB_SPARE, &check);
-	vm_offset_t imem = ml_io_map(SP_IMEM_PA, 0x1000);
+	if (!sp_imem) {
+		sp_imem = ml_io_map(SP_IMEM_PA, 0x1000);
+	}
+	vm_offset_t imem = sp_imem;
 	if (imem) {
 		*(volatile uint32_t *)(imem + SP_IMEM_RESTART_REASON) = reason ? 0x77665500u | reason : 0;
 		__asm__ volatile("dsb sy" ::: "memory");
@@ -218,6 +227,23 @@ out:
 	return err;
 }
 
+void
+sweet_spmi_flush_next_boot(void)
+{
+	int reason = __atomic_load_n(&sweet_next_boot, __ATOMIC_ACQUIRE);
+
+	/*
+	 * sysctl_sweet_next_boot already wrote PON SOFT_RB_SPARE and IMEM when
+	 * kern.sweet_next_boot was set. In normal reboot context (IRQs on),
+	 * re-run sp_pon_set_reason() to ensure ordering before PSCI reset;
+	 * in panic/IRQ-off context skip IOLock/ml_io_map and just drain writes.
+	 */
+	if (reason != 0 && ml_get_interrupts_enabled()) {
+		(void)sp_pon_set_reason((unsigned)reason);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 static int
 sysctl_sweet_next_boot SYSCTL_HANDLER_ARGS
 {
