diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685..e3c8bda 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,66 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+extern "C" void sweet_spmi_flush_next_boot(void);
+
+#define PSCI_SYSTEM_OFF         0x84000008ULL
+#define PSCI_SYSTEM_RESET       0x84000009ULL
+
+static uint32_t sweet_panic_reboot;
+
+static int32_t
+sweet_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	      "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	uint64_t fn;
+	const char *op;
+
+	if (type == kPEPanicRestartCPU || type == kPEPanicRestartCPUNoCallouts) {
+		if (!sweet_panic_reboot) {
+			kprintf("SWEET: panic screen held (set sweetpanicreboot=1 to reset on panic)\n");
+			for (;;) {
+				__asm__ volatile("wfe");
+			}
+		}
+		type = kPERestartCPU;
+	}
+
+	switch (type) {
+	case kPERestartCPU:
+		sweet_spmi_flush_next_boot();
+		fn = PSCI_SYSTEM_RESET;
+		op = "SYSTEM_RESET";
+		break;
+	case kPEHaltCPU:
+		fn = PSCI_SYSTEM_OFF;
+		op = "SYSTEM_OFF";
+		break;
+	default:
+		return -1;
+	}
+
+	kprintf("SWEET: PSCI %s (fn=0x%llx, type=%u)\n", op, fn, type);
+	__asm__ volatile("dsb sy" ::: "memory");
+	int32_t rc = sweet_psci_call(fn);
+	kprintf("SWEET: PSCI %s returned %d\n", op, rc);
+	return -1;
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -29,8 +89,11 @@ SweetPlatformExpert::start(IOService *provider)
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
 	}
+	(void)PE_parse_boot_argn("sweetpanicreboot", &sweet_panic_reboot, sizeof(sweet_panic_reboot));
+	PE_halt_restart = sweet_halt_restart;
 	registerService();
-	IOLog("SWEET: platform expert registered\n");
+	IOLog("SWEET: platform expert registered (PSCI reset/off installed, panicreboot=%u)\n",
+	    sweet_panic_reboot ? 1u : 0u);
 	return true;
 }
 
