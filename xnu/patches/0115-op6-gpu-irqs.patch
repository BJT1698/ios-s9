+/* ---- 9. Interrupts (G5: RBBM / GPU SMMU / GMU) ---- */
+
+static int irq_boot_arg = 1;
+static int irq_armed;
+static uint64_t gpu_irq_total;
+static int gpu_irq_error_seen;
+static sweet_gpu_wake_fn gpu_wake_fn;
+static void *gpu_wake_arg;
+
+static uint32_t irq_cb_fault_pending;
+static int irq_cb_fault_bank;
+static uint32_t irq_cb_fault_fsr, irq_cb_fault_fsynr;
+static uint64_t irq_cb_fault_far;
+
+static uint32_t irq_glb_fault_pending;
+static uint32_t irq_glb_fault_gfsr, irq_glb_fault_gsyn0, irq_glb_fault_gsyn1;
+
+static uint32_t irq_gpu_err_pending;
+static uint32_t irq_gpu_err_i0, irq_gpu_err_ci, irq_gpu_err_flt, irq_gpu_err_pr;
+
+static uint32_t irq_gmu_err_pending;
+static uint32_t irq_gmu_err_ao, irq_gmu_err_hfi;
+
+void
+sweet_gpu_set_wake_cb(sweet_gpu_wake_fn fn, void *arg)
+{
+	gpu_wake_arg = arg;
+	__atomic_store_n(&gpu_wake_fn, fn, __ATOMIC_RELEASE);
+}
+
+int
+sweet_gpu_irq_enabled(void)
+{
+	return __atomic_load_n(&irq_armed, __ATOMIC_ACQUIRE);
+}
+
+int
+sweet_gpu_irq_fatal(void)
+{
+	return __atomic_load_n(&gpu_irq_error_seen, __ATOMIC_ACQUIRE);
+}
+
+uint64_t
+sweet_gpu_irq_count(void)
+{
+	return __atomic_load_n(&gpu_irq_total, __ATOMIC_RELAXED);
+}
+
+static inline void
+gpu_irq_wake(void)
+{
+	sweet_gpu_wake_fn fn = __atomic_load_n(&gpu_wake_fn, __ATOMIC_ACQUIRE);
+	if (fn != NULL) {
+		fn(gpu_wake_arg);
+	}
+}
+
+void
+sweet_gpu_irq_drain_logs(void)
+{
+	if (__atomic_exchange_n(&irq_cb_fault_pending, 0, __ATOMIC_ACQUIRE)) {
+		LOG("FAULT irq cb%d fsr=%08x far=%llx fsynr=%08x\n",
+		    irq_cb_fault_bank, irq_cb_fault_fsr, irq_cb_fault_far, irq_cb_fault_fsynr);
+	}
+	if (__atomic_exchange_n(&irq_glb_fault_pending, 0, __ATOMIC_ACQUIRE)) {
+		LOG("FAULT irq global gfsr=%08x gsyn0=%08x gsyn1(sid)=%08x\n",
+		    irq_glb_fault_gfsr, irq_glb_fault_gsyn0, irq_glb_fault_gsyn1);
+	}
+	if (__atomic_exchange_n(&irq_gpu_err_pending, 0, __ATOMIC_ACQUIRE)) {
+		LOG("RBBM error irq i0=%08x ci=%08x flt=%08x pr=%08x\n",
+		    irq_gpu_err_i0, irq_gpu_err_ci, irq_gpu_err_flt, irq_gpu_err_pr);
+	}
+	if (__atomic_exchange_n(&irq_gmu_err_pending, 0, __ATOMIC_ACQUIRE)) {
+		LOG("GMU error irq ao=%08x hfi=%08x\n",
+		    irq_gmu_err_ao, irq_gmu_err_hfi);
+	}
+}
+
+static void
+gpu_irq_handler(void *refcon __unused, uint32_t intid __unused)
+{
+	uint32_t st = gr(RBBM_INT_0_STATUS);
+
+	__atomic_fetch_add(&gpu_irq_total, 1, __ATOMIC_RELAXED);
+	if (st == 0) {
+		return;
+	}
+	wr(GPU(RBBM_INT_CLEAR_CMD), st);
+
+	uint32_t err = st & INT0_ERR_MASK;
+	if (err != 0) {
+		/* Mask persistent error bits to prevent a level-triggered storm before EOI. */
+		uint32_t mask = gr(RBBM_INT_0_MASK);
+		wr(GPU(RBBM_INT_0_MASK), mask & ~err);
+		irq_gpu_err_i0 = err;
+		irq_gpu_err_ci = gr(CP_INTERRUPT_STATUS);
+		irq_gpu_err_flt = gr(CP_HW_FAULT);
+		irq_gpu_err_pr = gr(CP_PROTECT_STATUS);
+		__atomic_store_n(&irq_gpu_err_pending, 1, __ATOMIC_RELEASE);
+		__atomic_store_n(&gpu_irq_error_seen, 1, __ATOMIC_RELEASE);
+		kprintf("SWEET GPU: RBBM error irq i0=%08x ci=%08x flt=%08x pr=%08x\n",
+		    err, irq_gpu_err_ci, irq_gpu_err_flt, irq_gpu_err_pr);
+	}
+	if (st & (INT0_CP_CACHE_FLUSH_TS | INT0_ERR_MASK)) {
+		gpu_irq_wake();
+	}
+}
+
+static void
+smmu_cb_irq_handler(void *refcon, uint32_t intid)
+{
+	int bank = (int)(uintptr_t)refcon;
+	if (bank < 0) {
+		return;
+	}
+	uint32_t base = npage * pgsz + (uint32_t)bank * pgsz;
+	vm_offset_t c = SMMU(base);
+	uint32_t fsr = rd32(c + CB_FSR);
+
+	__atomic_fetch_add(&gpu_irq_total, 1, __ATOMIC_RELAXED);
+	if (!(fsr & FSR_ALL)) {
+		return;
+	}
+	uint64_t far = rd64(c + CB_FAR);
+	uint32_t fsynr = rd32(c + CB_FSYNR0);
+	wr(c + CB_FSR, fsr & FSR_ALL);
+	__atomic_fetch_add(&gpu_faults, 1, __ATOMIC_RELAXED);
+	irq_cb_fault_bank = bank;
+	irq_cb_fault_fsr = fsr;
+	irq_cb_fault_far = far;
+	irq_cb_fault_fsynr = fsynr;
+	__atomic_store_n(&irq_cb_fault_pending, 1, __ATOMIC_RELEASE);
+	kprintf("SWEET GPU: SMMU fault irq(intid=%u cb%d) fsr=%08x far=%llx fsynr=%08x\n",
+	    intid, bank, fsr, far, fsynr);
+	if (bank == gcb) {
+		gpu_irq_wake();
+	}
+}
+
+static void
+smmu_global_irq_handler(void *refcon __unused, uint32_t intid)
+{
+	uint32_t gfsr = rd32(SMMU(S_GFSR));
+
+	__atomic_fetch_add(&gpu_irq_total, 1, __ATOMIC_RELAXED);
+	if (gfsr == 0) {
+		return;
+	}
+	uint32_t gsyn0 = rd32(SMMU(S_GFSYNR0));
+	uint32_t gsyn1 = rd32(SMMU(S_GFSYNR1));
+	wr(SMMU(S_GFSR), gfsr);
+	__atomic_fetch_add(&gpu_faults, 1, __ATOMIC_RELAXED);
+	irq_glb_fault_gfsr = gfsr;
+	irq_glb_fault_gsyn0 = gsyn0;
+	irq_glb_fault_gsyn1 = gsyn1;
+	__atomic_store_n(&irq_glb_fault_pending, 1, __ATOMIC_RELEASE);
+	kprintf("SWEET GPU: SMMU global fault irq(intid=%u) gfsr=%08x gsyn0=%08x gsyn1(sid)=%08x\n",
+	    intid, gfsr, gsyn0, gsyn1);
+}
+
+static void
+gmu_hfi_irq_handler(void *refcon __unused, uint32_t intid)
+{
+	uint32_t info = rd32(GMU(GMU_GMU2HOST_INTR_INFO));
+
+	__atomic_fetch_add(&gpu_irq_total, 1, __ATOMIC_RELAXED);
+	if (info == 0) {
+		return;
+	}
+	wr(GMU(GMU_GMU2HOST_INTR_CLR), info);
+	if (info & INTR_CM3_FAULT) {
+		uint32_t mask = rd32(GMU(GMU_GMU2HOST_INTR_MASK));
+		wr(GMU(GMU_GMU2HOST_INTR_MASK), mask | INTR_CM3_FAULT);
+		irq_gmu_err_hfi = info;
+		__atomic_store_n(&irq_gmu_err_pending, 1, __ATOMIC_RELEASE);
+		__atomic_store_n(&gpu_irq_error_seen, 1, __ATOMIC_RELEASE);
+		kprintf("SWEET GPU: GMU CM3_FAULT irq(intid=%u) info=%08x\n", intid, info);
+		gpu_irq_wake();
+	}
+}
+
+static void
+gmu_ao_irq_handler(void *refcon __unused, uint32_t intid)
+{
+	uint32_t st = rd32(GMU(GMU_AO_HOST_INTR_STATUS));
+
+	__atomic_fetch_add(&gpu_irq_total, 1, __ATOMIC_RELAXED);
+	if (st == 0) {
+		return;
+	}
+	wr(GMU(GMU_AO_HOST_INTR_CLR), st);
+	uint32_t err = st & GMU_AO_ERR_MASK;
+	if (err != 0) {
+		uint32_t mask = rd32(GMU(GMU_AO_HOST_INTR_MASK));
+		wr(GMU(GMU_AO_HOST_INTR_MASK), mask | err);
+		irq_gmu_err_ao = err;
+		__atomic_store_n(&irq_gmu_err_pending, 1, __ATOMIC_RELEASE);
+		kprintf("SWEET GPU: GMU AO irq(intid=%u) st=%08x\n", intid, st);
+		if (err & GMU_AO_WDOG_BITE) {
+			__atomic_store_n(&gpu_irq_error_seen, 1, __ATOMIC_RELEASE);
+			gpu_irq_wake();
+		}
+	}
+}
+
+static void
+gpu_irq_disarm(void)
+{
+	if (!__atomic_exchange_n(&irq_armed, 0, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	sweet_gic_disable_spi(SWEET_GPU_INTID);
+	sweet_gic_disable_spi(SWEET_GMU_HFI_INTID);
+	sweet_gic_disable_spi(SWEET_GMU_AO_INTID);
+	sweet_gic_disable_spi(SWEET_SMMU_GLB0_INTID);
+	sweet_gic_disable_spi(SWEET_SMMU_GLB1_INTID);
+	if (gcb >= 0) {
+		sweet_gic_disable_spi(SWEET_SMMU_CB_INTID(gcb));
+	}
+	if (cb >= 0 && cb != gcb) {
+		sweet_gic_disable_spi(SWEET_SMMU_CB_INTID(cb));
+	}
+	if (g.gpu) {
+		wr(GPU(RBBM_INT_0_MASK), 0);
+	}
+	if (g.gmu) {
+		wr(GMU(GMU_AO_HOST_INTR_MASK), ~0u);
+	}
+	if (g.smmu) {
+		if (gcbbase) {
+			wr(SMMU(gcbbase + CB_SCTLR), rd32(SMMU(gcbbase + CB_SCTLR)) & ~SCTLR_CFIE);
+		}
+		if (cbbase) {
+			wr(SMMU(cbbase + CB_SCTLR), rd32(SMMU(cbbase + CB_SCTLR)) & ~SCTLR_CFIE);
+		}
+		wr(SMMU(S_CR0), rd32(SMMU(S_CR0)) & ~S_CR0_GFIE);
+	}
+}
+
+static void
+gpu_irq_arm(void)
+{
+	if (!irq_boot_arg) {
+		LOG("IRQs disabled by boot-arg (sweetgpuirq=0): using polled waits\n");
+		return;
+	}
+	/* Clear pending hardware sources and enable device interrupt masks before unmasking at GIC. */
+	if (gcbbase) {
+		wr(SMMU(gcbbase + CB_FSR), FSR_ALL);
+		wr(SMMU(gcbbase + CB_SCTLR), rd32(SMMU(gcbbase + CB_SCTLR)) | SCTLR_CFIE);
+	}
+	if (cbbase) {
+		wr(SMMU(cbbase + CB_FSR), FSR_ALL);
+		wr(SMMU(cbbase + CB_SCTLR), rd32(SMMU(cbbase + CB_SCTLR)) | SCTLR_CFIE);
+	}
+	wr(SMMU(S_GFSR), rd32(SMMU(S_GFSR)));
+	wr(SMMU(S_CR0), rd32(SMMU(S_CR0)) | S_CR0_GFIE);
+
+	wr(GPU(RBBM_INT_CLEAR_CMD), ~0u);
+	wr(GPU(RBBM_INT_0_MASK), INT0_ACTIVE_MASK);
+
+	wr(GMU(GMU_GMU2HOST_INTR_CLR), ~0u);
+	wr(GMU(GMU_GMU2HOST_INTR_MASK), ~(INTR_MSGQ | INTR_CM3_FAULT));
+	wr(GMU(GMU_AO_HOST_INTR_CLR), ~0u);
+	wr(GMU(GMU_AO_HOST_INTR_MASK), ~GMU_AO_ERR_MASK);
+
+	if (sweet_gic_register_spi(SWEET_GPU_INTID, 0, gpu_irq_handler, NULL, 1) != 0) {
+		wr(GPU(RBBM_INT_0_MASK), 0);
+		wr(GMU(GMU_AO_HOST_INTR_MASK), ~0u);
+		LOG("GIC SPI registration failed for INTID %u: falling back to polled waits\n", SWEET_GPU_INTID);
+		return;
+	}
+	if (gcb >= 0) {
+		(void)sweet_gic_register_spi(SWEET_SMMU_CB_INTID(gcb), 1, smmu_cb_irq_handler,
+		    (void *)(uintptr_t)gcb, 1);
+	}
+	if (cb >= 0 && cb != gcb) {
+		(void)sweet_gic_register_spi(SWEET_SMMU_CB_INTID(cb), 1, smmu_cb_irq_handler,
+		    (void *)(uintptr_t)cb, 1);
+	}
+	(void)sweet_gic_register_spi(SWEET_GMU_HFI_INTID, 0, gmu_hfi_irq_handler, NULL, 1);
+	(void)sweet_gic_register_spi(SWEET_GMU_AO_INTID, 0, gmu_ao_irq_handler, NULL, 1);
+	(void)sweet_gic_register_spi(SWEET_SMMU_GLB0_INTID, 0, smmu_global_irq_handler, NULL, 1);
+	(void)sweet_gic_register_spi(SWEET_SMMU_GLB1_INTID, 0, smmu_global_irq_handler, NULL, 1);
+
+	__atomic_store_n(&irq_armed, 1, __ATOMIC_RELEASE);
+	LOG("IRQs armed: GPU=%u GMU=%u/%u SMMU_CB=%u/%u glb=%u/%u\n",
+	    SWEET_GPU_INTID, SWEET_GMU_HFI_INTID, SWEET_GMU_AO_INTID,
+	    gcb >= 0 ? SWEET_SMMU_CB_INTID(gcb) : 0u,
+	    cb >= 0 ? SWEET_SMMU_CB_INTID(cb) : 0u,
+	    SWEET_SMMU_GLB0_INTID, SWEET_SMMU_GLB1_INTID);
+}
