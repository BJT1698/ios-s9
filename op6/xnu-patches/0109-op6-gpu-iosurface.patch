+}
+
+void
+sweet_gpu_surf_unmap(uint64_t iova, uint32_t size)
+{
+	uint64_t span = (size + 0xfffu) & ~0xfffull;
+	if (!gpu_ready || iova < VA_SURF_BASE || span == 0) {
+		return;
+	}
+	pt_unmap(&gpu_pt, iova, (uint32_t)span);
+	cb_tlb_inv(gcbbase);
+	unsigned i = 0;
+	while (i < surf_free_count && surf_free[i].start < iova) {
+		i++;
+	}
+	if (i > 0 && surf_free[i - 1].start + surf_free[i - 1].size == iova) {
+		surf_free[i - 1].size += span;
+		if (i < surf_free_count && surf_free[i - 1].start + surf_free[i - 1].size == surf_free[i].start) {
+			surf_free[i - 1].size += surf_free[i].size;
+			surf_free_count--;
+			for (unsigned j = i; j < surf_free_count; j++) {
+				surf_free[j] = surf_free[j + 1];
+			}
+		}
+		return;
+	}
+	if (i < surf_free_count && iova + span == surf_free[i].start) {
+		surf_free[i].start = iova;
+		surf_free[i].size += span;
+		return;
+	}
+	if (surf_free_count < SURF_MAX_FREE) {
+		for (unsigned j = surf_free_count; j > i; j--) {
+			surf_free[j] = surf_free[j - 1];
+		}
+		surf_free[i].start = iova;
+		surf_free[i].size = span;
+		surf_free_count++;
+	}
+}
