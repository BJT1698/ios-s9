+extern "C" bool
+sweet_gpu_surface_ready(uint32_t id, void *kernel, uint64_t size)
+{
+	if (id == 0 || id >= 4096 || !sweet_gpu_ready()) {
+		return true;
+	}
+	uint32_t fence = gSurfaceFence[id];
+	if (fence == 0) {
+		return true;
+	}
+	if (!sweet_gpu_fence_done(fence)) {
+		if (gSweetGPULock == NULL) {
+			return false;
+		}
+		IOLockLock(gSweetGPULock);
+		bool ok = sweet_gpu_wait_locked(fence, 50);
+		IOLockUnlock(gSweetGPULock);
+		if (!ok) {
+			return false;
+		}
+	}
+	if (gSurfaceFlushed[id] != fence && kernel != NULL && size != 0) {
+		flush_dcache((vm_offset_t)kernel, (vm_size_t)size, FALSE);
+		gSurfaceFlushed[id] = fence;
+	}
+	return true;
+}
