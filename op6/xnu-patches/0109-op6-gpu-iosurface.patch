+uint64_t
+sweet_gpu_surf_alloc_va(uint32_t size)
+{
+	uint64_t need = (size + 0xfffu) & ~0xfffull;
+	if (!gpu_ready || need == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < surf_free_count; i++) {
+		if (surf_free[i].size < need) {
+			continue;
+		}
+		uint64_t va = surf_free[i].start;
+		surf_free[i].start += need;
+		surf_free[i].size -= need;
+		if (surf_free[i].size == 0) {
+			surf_free_count--;
+			for (unsigned j = i; j < surf_free_count; j++) {
+				surf_free[j] = surf_free[j + 1];
+			}
+		}
+		return va;
+	}
+	return 0;
