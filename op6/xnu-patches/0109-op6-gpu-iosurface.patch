+		return kIOReturnNoResources;
+	}
+	uint32_t size = (surface->allocSize + 0xfffu) & ~0xfffu;
+	uint64_t iova = sweet_gpu_surf_alloc_va(size);
+	if (iova == 0) {
+		IOLockUnlock(gSweetGPULock);
+		surface->release();
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t off = 0; off < size; off += 4096u) {
+		IOByteCount segLen = 0;
+		addr64_t phys = surface->memory->getPhysicalSegment(off, &segLen, kIOMemoryMapperNone);
