+/*
+ * Carve-out and page-table pool usage for the ioreg counters (patch 0114). Called with
+ * gSweetGPULock held (the bitmap and counters only change under it). Largest free = the
+ * longest run of free 16K groups, i.e. the biggest GEM_NEW that can succeed now.
+ */
+void
+sweet_gpu_mem_stats(struct sweet_gpu_mem_stats *st)
+{
+	uint32_t run = 0, best = 0;
+
+	bzero(st, sizeof(*st));
+	if (!gpu_ready) {
+		return;
+	}
+	for (uint32_t p = 0; p + 4u <= bo_total_pages; p += 4u) {
+		if (bmap_test(p)) {
+			run = 0;
+		} else if (++run > best) {
