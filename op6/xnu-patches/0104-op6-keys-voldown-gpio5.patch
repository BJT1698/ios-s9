+/*
+ * OnePlus 6: volume-down from the PMIC GPIO the ADT names. Same read-only
+ * checks as volume-up: enabled, digital input; otherwise withheld (RESIN
+ * is not used either: the OP6 DT disables it).
+ */
+static void
+keys_voldown_gpio(uint32_t count)
+{
+	DTEntry buttons;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	uint32_t n = 0;
+
+	if (SecureDTLookupEntry(NULL, "/buttons", &buttons) != kSuccess ||
+	    SecureDTGetProperty(buttons, "voldown-pmic-gpio", &prop, &size) != kSuccess) {
+		return;
+	}
+	if (size != sizeof(n)) {
+		printf("SWEET KEYS: /buttons/voldown-pmic-gpio: %u bytes, want 4; volume-down withheld\n", size);
+		keys_vd_base = 0xffffu;	/* never RESIN on such a board */
+		keys_vd_apid = KEYS_NO_APID;
+		return;
+	}
+	memcpy(&n, prop, sizeof(n));
+	if (n < 1 || n > KEYS_PMIC_GPIO_MAX) {
+		printf("SWEET KEYS: voldown-pmic-gpio=%u out of range; volume-down withheld\n", n);
+		keys_vd_base = 0xffffu;
+		keys_vd_apid = KEYS_NO_APID;
+		return;
+	}
+	keys_vd_base = (uint16_t)(0xc000u + (n - 1u) * 0x100u);
+	keys_vd_apid = keys_find_apid((uint16_t)(keys_vd_base >> 8), count);
+	uint8_t rt = 0, mode = 0, en = 0, subtype = 0;
+	bool rok = keys_read(keys_vd_apid, (uint16_t)(keys_vd_base + 0x10u), &rt);
+	bool mok = keys_read(keys_vd_apid, (uint16_t)(keys_vd_base + 0x40u), &mode);
+	bool eok = keys_read(keys_vd_apid, (uint16_t)(keys_vd_base + 0x46u), &en);
+	bool sok = keys_read(keys_vd_apid, (uint16_t)(keys_vd_base + 0x05u), &subtype);
+	printf("SWEET KEYS: volume-down = PMIC GPIO%u ppid=%#x apid=%u rt=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    n, keys_vd_base >> 8, keys_vd_apid, rt, rok, mode, mok, en, eok, subtype, sok);
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!rok || !eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+		printf("SWEET KEYS: GPIO%u not confirmed enabled as input; volume-down withheld, PMIC unchanged\n", n);
+		keys_vd_apid = KEYS_NO_APID;	/* keys_read fails: never reported */
+	}
+}
+
