+static void
+rmi_run(void)
+{
+	int err = ETIMEDOUT;
+
+	(void)PE_parse_boot_argn("sweettouchflip", &rmi.flip, sizeof(rmi.flip));
+	rmi.page = -1;
+	st.east = ml_io_map(OP6_EAST_PA, OP6_EAST_LEN);
+	if (!st.east) {
+		printf("SWEET TOUCH: OP6 TLMM EAST mapping failed\n");
+		return;
+	}
+	touch_wr(st.east, TOUCH_GPIO_CFG(RMI_IRQ), RMI_IRQ_CTL);
+	bb_init(&rmi_bus);
+	printf("SWEET TOUCH: OP6 lines sda=%u scl=%u irq=%u, panel %dx%d\n",
+	    touch_level(RMI_SDA), touch_level(RMI_SCL), rmi_irq_level(), st.panel_w, st.panel_h);
+	if (!touch_level(RMI_SDA) || !touch_level(RMI_SCL)) {
+		printf("SWEET TOUCH: OP6 touch bus held low; stopping\n");
+		return;
+	}
+	for (int i = 0; i < 3 && err; i++) {
+		err = i2c_wr(&rmi_bus, RMI_ADDR, NULL, 0);     /* START, address + W, STOP */
+		if (err) {
+			delay(2000);
+		}
+	}
+	if (err) {
+		printf("SWEET TOUCH: OP6 touch: no ACK at 0x20 (err=%d)\n", err);
+		return;
+	}
+	if ((err = rmi_scan())) {
+		printf("SWEET TOUCH: OP6 PDT scan err=%d\n", err);
+		return;
+	}
+	for (unsigned i = 0; i < rmi.nfn; i++) {
+		const struct rmi_fn *f = &rmi.fn[i];
+		printf("SWEET TOUCH: F%02x page %u q%02x k%02x c%02x d%02x irqs %u@%u\n",
+		    f->num, f->page, f->query, f->cmd, f->ctrl, f->data, f->irqs, f->irq_pos);
+	}
+	rmi.f01 = rmi_find(0x01);
+	rmi.f12 = rmi_find(0x12);
+	if (!rmi.f01 || !rmi.f12 || rmi.irq_count == 0 || rmi.irq_count > 32) {
+		printf("SWEET TOUCH: OP6 no F01/F12 (irqs %u); stopping\n", rmi.irq_count);
+		return;
+	}
+	uint8_t q[21], status = 0;
+	if (!rmi_read(rmi_addr(rmi.f01, rmi.f01->query), q, sizeof(q)) &&
+	    !rmi_read(rmi_addr(rmi.f01, rmi.f01->data), &status, 1)) {
+		char id[11];
+		unsigned n = 0;
+		for (; n < 10 && q[11 + n]; n++) {
+			id[n] = q[11 + n] >= 0x20 && q[11 + n] < 0x7f ? (char)q[11 + n] : '.';
+		}
+		id[n] = 0;
+		printf("SWEET TOUCH: F01 manufacturer %#x product %s status %#x\n", q[0], id, status);
+	}
+	if ((err = rmi_f01_config())) {
+		printf("SWEET TOUCH: OP6 F01 configuration err=%d; stopping\n", err);
+		return;
+	}
+	if ((err = rmi_f12_setup(rmi.f12))) {
+		printf("SWEET TOUCH: OP6 F12 setup failed at step %d; stopping\n", err);
+		return;
+	}
+	printf("SWEET TOUCH: OP6 rmi4 sensing, %u objects, flip=%u, read while IRQ low, poll=5ms\n",
+	    rmi.fingers, rmi.flip);
+	printf("SWEET TOUCH: bound to cpu %d\n", sweet_bind_current_thread(1));
+	unsigned errors = 0;
+	for (;;) {
+		if (!rmi_irq_level()) {
+			err = rmi_attention();
+			if (err) {
+				rmi.page = -1;
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: OP6 report err=%d\n", err);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y);
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(5);
+	}
+}
