+/*
+ * OnePlus 6 (/chosen/sweet-board = "oneplus,enchilada"): Synaptics S3706B,
+ * RMI4 over I2C at 0x20 on i2c12's pins as plain GPIO (SDA GPIO49, SCL
+ * GPIO50, NORTH tile like the S9's 31/32), attention on GPIO125 (EAST tile,
+ * low while an interrupt is pending). The shim (op6/shim/m4.c) powers it
+ * before XNU starts: GPIO88 high (vio), RPMh ldoa28 3008 mV, reset pulse on
+ * GPIO99. Here it is only probed; no rail, reset or GPIO99 access.
+ * Register layout as the OP6 shim's rmi4.c (M5, proven on the phone):
+ *   - 256-byte pages, register 0xFF selects the page;
+ *   - Page Description Table from 0xE9 down, 6-byte entries;
+ *   - F01 ctrl0 |= nosleep | configured, F01 ctrl1.. interrupt enable;
+ *   - F12 register descriptors (query + 1/+4/+7) locate data1, 8-byte
+ *     object records (type, x LE16, y LE16, z, wx, wy); control 8
+ *     subpacket 0 is max X/Y.
+ * Only IC writes: page select, F01 ctrl0, F01 interrupt enable.
+ */
+#define OP6_EAST_PA       0x03500000u /* DT TLMM + EAST (0x100000) */
+#define OP6_EAST_LEN      0x0007e000u /* through GPIO125 */
+#define RMI_SDA           49u
+#define RMI_SCL           50u
+#define RMI_IRQ           125u        /* EAST tile */
+#define RMI_IRQ_CTL       ((7u << 6) | 3u) /* DT ts-int-state: gpio, input, pull-up, 16 mA */
+#define RMI_ADDR          0x20u
+#define RMI_PAGE_SELECT   0xffu
+#define RMI_PDT_TOP       0xe9
+#define RMI_PDT_BOTTOM    0x05
+#define RMI_MAX_FN        16u
+#define RMI_MAX_PAGES     16u
+#define RMI_DESC_REGS     64u
+#define RMI_DESC_BUF      255u
+#define RMI_F01_NOSLEEP   (1u << 2)
+#define RMI_F01_CONFIGURED (1u << 7)
+#define RMI_REC           8u          /* F12 data1 object record */
+#define RMI_FULL_EVERY    8u          /* reads with a finger down between full reads */
+
+static const struct touch_bus rmi_bus = {RMI_SDA, RMI_SCL};
+
+struct rmi_fn {
+	uint8_t num, page, query, cmd, ctrl, data, irqs, irq_pos;
+};
+
+struct rmi_desc {
+	uint16_t struct_size;
+	uint8_t nregs;
+	uint8_t present[RMI_DESC_REGS];
+	uint16_t size[RMI_DESC_REGS];
+	uint8_t nsub[RMI_DESC_REGS];
+	uint8_t sub0[RMI_DESC_REGS];
+};
+
+static struct {
+	int page;                       /* -1: unknown, select before the next access */
+	unsigned nfn, irq_count;
+	struct rmi_fn fn[RMI_MAX_FN];
+	struct rmi_desc desc;
+	const struct rmi_fn *f01, *f12;
+	uint16_t data_addr, data1_off, max_x, max_y;
+	unsigned fingers, flip, reads;
+} rmi;
+
+static bool
+touch_board_is(const char *want)
+{
+	DTEntry chosen;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	size_t n = strlen(want) + 1;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-board", &prop, &size) != kSuccess) {
+		return false;
+	}
+	return size >= n && memcmp(prop, want, n) == 0;
+}
+
+static unsigned
+rmi_irq_level(void)
+{
+	return touch_rd(st.east, TOUCH_GPIO_IO(RMI_IRQ)) & 1u;
+}
+
+static int
+rmi_select(unsigned page)
+{
+	if (rmi.page == (int)page) {
+		return 0;
+	}
+	uint8_t sel[2] = {RMI_PAGE_SELECT, (uint8_t)page};
+	int err = i2c_wr(&rmi_bus, RMI_ADDR, sel, 2);
+	rmi.page = err ? -1 : (int)page;
+	return err;
+}
+
+static int
+rmi_read(uint16_t a, uint8_t *buf, unsigned n)
+{
+	int err = rmi_select(a >> 8);
+	return err ? err : i2c_rd(&rmi_bus, RMI_ADDR, (uint8_t)a, buf, n);
+}
+
+static int
+rmi_write(uint16_t a, const uint8_t *buf, unsigned n)
+{
+	uint8_t tx[17];
+	if (n > 16) {
+		return EINVAL;
+	}
+	int err = rmi_select(a >> 8);
+	if (err) {
+		return err;
+	}
+	tx[0] = (uint8_t)a;
+	memcpy(tx + 1, buf, n);
+	return i2c_wr(&rmi_bus, RMI_ADDR, tx, n + 1u);
+}
+
+static uint16_t
+rmi_addr(const struct rmi_fn *f, uint8_t base)
+{
+	return (uint16_t)((f->page << 8) | base);
+}
+
+static int
+rmi_scan(void)
+{
+	unsigned empty = 0;
+	rmi.nfn = 0;
+	rmi.irq_count = 0;
+	for (unsigned page = 0; page < RMI_MAX_PAGES && empty < 2; page++) {
+		unsigned found = 0;
+		for (int a = RMI_PDT_TOP; a >= RMI_PDT_BOTTOM; a -= 6) {
+			uint8_t e[6];
+			int err = rmi_read((uint16_t)((page << 8) | (unsigned)a), e, sizeof(e));
+			if (err) {
+				return err;
+			}
+			if (e[5] == 0x00 || e[5] == 0xff) {
+				break;
+			}
+			found++;
+			if (rmi.nfn < RMI_MAX_FN) {
+				struct rmi_fn *f = &rmi.fn[rmi.nfn++];
+				f->num = e[5];
+				f->page = (uint8_t)page;
+				f->query = e[0];
+				f->cmd = e[1];
+				f->ctrl = e[2];
+				f->data = e[3];
+				f->irqs = e[4] & 7u;
+				f->irq_pos = (uint8_t)rmi.irq_count;
+			}
+			rmi.irq_count += e[4] & 7u;
+		}
+		empty = found ? 0 : empty + 1;
+	}
+	return 0;
+}
+
+static const struct rmi_fn *
+rmi_find(uint8_t num)
+{
+	for (unsigned i = 0; i < rmi.nfn; i++) {
+		if (rmi.fn[i].num == num) {
+			return &rmi.fn[i];
+		}
+	}
+	return NULL;
+}
+
+/* A function's interrupt bits as a mask over the F01 status/enable bytes. */
+static uint32_t
+rmi_irq_mask(const struct rmi_fn *f)
+{
+	uint32_t m = 0;
+	for (unsigned i = 0; i < f->irqs && f->irq_pos + i < 32u; i++) {
+		m |= 1u << (f->irq_pos + i);
+	}
+	return m;
+}
+
+/*
+ * Register descriptor (op6/shim/rmi4.c rmi_read_desc): a size byte, the
+ * presence register (structure size, or 0 + LE16), a bitmap of present
+ * registers, then per register its size (8/16/32-bit) and subpacket bitmap
+ * bytes (7 bits each, bit 7 continues). 0 ok, errno or -1/-2/-3 malformed.
+ */
+static int
+rmi_read_desc(uint16_t a, struct rmi_desc *d)
+{
+	uint8_t psize = 0, pres[35], buf[RMI_DESC_BUF];
+	unsigned first, bit = 0, off = 0;
+	int err;
+
+	memset(d, 0, sizeof(*d));
+	if ((err = rmi_read(a, &psize, 1))) {
+		return err;
+	}
+	if (psize < 1 || psize > sizeof(pres)) {
+		return -1;
+	}
+	if ((err = rmi_read((uint16_t)(a + 1), pres, psize))) {
+		return err;
+	}
+	if (pres[0] == 0) {
+		if (psize < 3) {
+			return -1;
+		}
+		d->struct_size = (uint16_t)(pres[1] | (pres[2] << 8));
+		first = 3;
+	} else {
+		d->struct_size = pres[0];
+		first = 1;
+	}
+	if (d->struct_size > RMI_DESC_BUF) {
+		return -2;
+	}
+	if ((err = rmi_read((uint16_t)(a + 2), buf, d->struct_size))) {
+		return err;
+	}
+	for (unsigned i = first; i < psize; i++) {
+		for (unsigned b = 0; b < 8; b++, bit++) {
+			uint32_t size;
+			unsigned nsub = 0, sub0 = 0, sb = 0;
+			if (!((pres[i] >> b) & 1u)) {
+				continue;
+			}
+			if (off >= d->struct_size) {
+				return 0;       /* structure shorter than the map: stop */
+			}
+			size = buf[off++];
+			if (size == 0) {
+				if (off + 2 > d->struct_size) {
+					return -3;
+				}
+				size = buf[off] | ((uint32_t)buf[off + 1] << 8);
+				off += 2;
+			}
+			if (size == 0) {
+				if (off + 4 > d->struct_size) {
+					return -3;
+				}
+				size = buf[off] | ((uint32_t)buf[off + 1] << 8) |
+				    ((uint32_t)buf[off + 2] << 16) | ((uint32_t)buf[off + 3] << 24);
+				off += 4;
+			}
+			for (;;) {
+				if (off >= d->struct_size) {
+					return -3;
+				}
+				uint8_t v = buf[off++];
+				for (unsigned k = 0; k < 7; k++, sb++) {
+					if ((v >> k) & 1u) {
+						nsub++;
+						if (sb < 7) {
+							sub0 |= 1u << sb;
+						}
+					}
+				}
+				if (!(v & 0x80u)) {
+					break;
+				}
+			}
+			if (size == 0 || bit >= RMI_DESC_REGS) {
+				continue;
+			}
+			d->present[bit] = 1;
+			d->size[bit] = size > 0xffffu ? 0xffffu : (uint16_t)size;
+			d->nsub[bit] = nsub > 255 ? 255 : (uint8_t)nsub;
+			d->sub0[bit] = (uint8_t)sub0;
+			d->nregs++;
+		}
+	}
+	return 0;
+}
+
+/* Register address offset of reg from its base (-1 absent). */
+static int
+rmi_desc_index(const struct rmi_desc *d, unsigned reg)
+{
+	int idx = 0;
+	if (reg >= RMI_DESC_REGS || !d->present[reg]) {
+		return -1;
+	}
+	for (unsigned i = 0; i < reg; i++) {
+		idx += d->present[i];
+	}
+	return idx;
+}
+
+/* Byte offset of reg in a block read from the base (-1 absent). */
+static int
+rmi_desc_offset(const struct rmi_desc *d, unsigned reg)
+{
+	int off = 0;
+	if (reg >= RMI_DESC_REGS || !d->present[reg]) {
+		return -1;
+	}
+	for (unsigned i = 0; i < reg; i++) {
+		if (d->present[i]) {
+			off += d->size[i];
+		}
+	}
+	return off;
+}
+
+static void
+rmi_desc_log(const char *what, const struct rmi_desc *d)
+{
+	char list[3 * RMI_DESC_REGS + 1];
+	unsigned n = 0;
+	for (unsigned r = 0; r < RMI_DESC_REGS && n + 4 < sizeof(list); r++) {
+		if (d->present[r]) {
+			n += (unsigned)snprintf(list + n, sizeof(list) - n, " %u", r);
+		}
+	}
+	list[n] = 0;
+	printf("SWEET TOUCH: F12 %s registers:%s\n", what, n ? list : " none");
+}
+
+/* 0 ok; the step that failed otherwise (op6/shim/rmi4.c f12_setup's codes). */
+static int
+rmi_f12_setup(const struct rmi_fn *f)
+{
+	uint16_t q = rmi_addr(f, f->query);
+	struct rmi_desc *d = &rmi.desc;
+	uint8_t q0 = 0, buf[16];
+	int idx, off;
+
+	if (rmi_read(q, &q0, 1)) {
+		return 8;
+	}
+	if (!(q0 & 1u)) {
+		return 1;
+	}
+	if (rmi_read_desc((uint16_t)(q + 1), d)) {
+		return 2;
+	}
+	if (rmi_read_desc((uint16_t)(q + 4), d)) {
+		return 3;
+	}
+	rmi_desc_log("control", d);
+	if ((idx = rmi_desc_index(d, 8)) < 0) {
+		return 5;
+	}
+	unsigned n = d->size[8] > sizeof(buf) ? sizeof(buf) : d->size[8];
+	if (rmi_read((uint16_t)(rmi_addr(f, f->ctrl) + idx), buf, n)) {
+		return 7;
+	}
+	if ((d->sub0[8] & 1u) && n >= 4) {
+		rmi.max_x = (uint16_t)(buf[0] | (buf[1] << 8));
+		rmi.max_y = (uint16_t)(buf[2] | (buf[3] << 8));
+	}
+	if (rmi_read_desc((uint16_t)(q + 7), d)) {
+		return 4;
+	}
+	rmi_desc_log("data", d);
+	if ((off = rmi_desc_offset(d, 1)) < 0) {
+		return 6;
+	}
+	rmi.data_addr = rmi_addr(f, f->data);
+	rmi.data1_off = (uint16_t)off;
+	rmi.fingers = d->nsub[1];
+	if (rmi.fingers > d->size[1] / RMI_REC) {
+		rmi.fingers = d->size[1] / RMI_REC;
+	}
+	if (rmi.fingers > TOUCH_MAX) {
+		rmi.fingers = TOUCH_MAX;
+	}
+	if (rmi.data1_off > RMI_DESC_BUF) {
+		return 10;      /* rmi_objects reads data0.. data1 into one buffer */
+	}
+	printf("SWEET TOUCH: F12 q0=%#x data1 off=%u size=%u objects=%u max x=%u y=%u\n",
+	    q0, rmi.data1_off, d->size[1], rmi.fingers, rmi.max_x, rmi.max_y);
+	return rmi.fingers ? 0 : 9;
+}
+
+/* F01 ctrl0 = no sleep | configured (sleep bits 0-1 cleared); F01 + F12 interrupts on. */
+static int
+rmi_f01_config(void)
+{
+	const struct rmi_fn *f01 = rmi.f01;
+	uint8_t c0 = 0, v, rb = 0, en[4] = {0, 0, 0, 0}, en2[4];
+	unsigned nen = (rmi.irq_count + 7u) / 8u;
+	uint32_t want = rmi_irq_mask(f01) | rmi_irq_mask(rmi.f12);
+	int err;
+
+	if ((err = rmi_read(rmi_addr(f01, f01->ctrl), &c0, 1))) {
+		return err;
+	}
+	v = (uint8_t)((c0 & ~3u) | RMI_F01_NOSLEEP | RMI_F01_CONFIGURED);
+	if ((err = rmi_write(rmi_addr(f01, f01->ctrl), &v, 1)) ||
+	    (err = rmi_read(rmi_addr(f01, f01->ctrl), &rb, 1))) {
+		return err;
+	}
+	if (nen == 0 || nen > 4) {
+		return EINVAL;
+	}
+	uint16_t ea = (uint16_t)(rmi_addr(f01, f01->ctrl) + 1);
+	if ((err = rmi_read(ea, en, nen))) {
+		return err;
+	}
+	for (unsigned i = 0; i < nen; i++) {
+		en2[i] = (uint8_t)(en[i] | (want >> (8 * i)));
+	}
+	if ((err = rmi_write(ea, en2, nen)) || (err = rmi_read(ea, en2, nen))) {
+		return err;
+	}
+	printf("SWEET TOUCH: F01 ctrl0 %#x -> %#x (read %#x), irq enable %02x%02x%02x%02x -> %02x%02x%02x%02x\n",
+	    c0, v, rb, en[3], en[2], en[1], en[0],
+	    nen > 3 ? en2[3] : 0, nen > 2 ? en2[2] : 0, nen > 1 ? en2[1] : 0, en2[0]);
+	return 0;
+}
+
+/* RMI4 x/y (0..max) -> panel pixels; boot-arg sweettouchflip: 1 x, 2 y, 4 swap axes. */
+static void
+rmi_to_panel(unsigned rx, unsigned ry, int *px, int *py)
+{
+	int w = st.panel_w, h = st.panel_h;
+	unsigned mx = rmi.max_x, my = rmi.max_y;
+	if (rmi.flip & 4u) {
+		unsigned t = rx;
+		rx = ry;
+		ry = t;
+		t = mx;
+		mx = my;
+		my = t;
+	}
+	int x = mx ? (int)((uint64_t)rx * (unsigned)(w - 1) / mx) : (int)rx;
+	int y = my ? (int)((uint64_t)ry * (unsigned)(h - 1) / my) : (int)ry;
+	x = x < 0 ? 0 : (x >= w ? w - 1 : x);
+	y = y < 0 ? 0 : (y >= h ? h - 1 : y);
+	*px = (rmi.flip & 1u) ? w - 1 - x : x;
+	*py = (rmi.flip & 2u) ? h - 1 - y : y;
+}
+
+/*
+ * F12 objects 0..n-1. A read of all ten records is 80 bytes, ~5 ms of
+ * bit-banging, so only the slots up to one past the highest one down are
+ * read; a new contact takes the lowest free slot [I]. A full read follows
+ * when the F12 interrupt fired and that prefix showed nothing new, and
+ * every RMI_FULL_EVERY reads while a finger is down, so a contact in a slot
+ * further up is never lost for long.
+ */
+static int
+rmi_objects(void)
+{
+	uint8_t buf[RMI_DESC_BUF + RMI_REC * TOUCH_MAX];
+	int xs[TOUCH_MAX], ys[TOUCH_MAX];
+	unsigned hi = 0, n;
+	uint32_t mask = 0;
+
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		xs[i] = st.x[i];
+		ys[i] = st.y[i];
+		if (st.active & (1u << i)) {
+			hi = i + 1;
+		}
+	}
+	n = hi + 1 < 2 ? 2 : hi + 1;
+	if (st.active && ++rmi.reads % RMI_FULL_EVERY == 0) {
+		n = rmi.fingers;
+	}
+	for (;;) {
+		if (n > rmi.fingers) {
+			n = rmi.fingers;
+		}
+		if (rmi.data1_off + RMI_REC * n > sizeof(buf)) {
+			return EINVAL;
+		}
+		int err = rmi_read(rmi.data_addr, buf, rmi.data1_off + RMI_REC * n);
+		if (err) {
+			return err;
+		}
+		mask = 0;
+		for (unsigned i = 0; i < n; i++) {
+			const uint8_t *r = buf + rmi.data1_off + RMI_REC * i;
+			if (r[0] == 0) {
+				continue;       /* 0: no object; 1 finger, 2 stylus, 3 palm, ... */
+			}
+			rmi_to_panel(r[1] | ((unsigned)r[2] << 8), r[3] | ((unsigned)r[4] << 8), &xs[i], &ys[i]);
+			mask |= 1u << i;
+		}
+		if (n >= rmi.fingers || mask != 0) {
+			break;
+		}
+		n = rmi.fingers;        /* the interrupt fired, nothing seen in the prefix */
+	}
+	touch_report(mask, xs, ys);
+	return 0;
+}
+
+/* One attention: F01 interrupt status, then the device status or F12 objects. */
+static int
+rmi_attention(void)
+{
+	const struct rmi_fn *f01 = rmi.f01;
+	uint8_t s[4] = {0, 0, 0, 0};
+	unsigned nst = (rmi.irq_count + 7u) / 8u;
+	int err = rmi_read((uint16_t)(rmi_addr(f01, f01->data) + 1), s, nst);
+	if (err) {
+		return err;
+	}
+	uint32_t bits = s[0] | ((uint32_t)s[1] << 8) | ((uint32_t)s[2] << 16) | ((uint32_t)s[3] << 24);
+	if (bits & rmi_irq_mask(f01)) {
+		uint8_t status = 0;
+		if ((err = rmi_read(rmi_addr(f01, f01->data), &status, 1))) {
+			return err;
+		}
+		if ((status & 0x0fu) == 1u || (status & 0x80u)) {
+			/* Reset or unconfigured: the controller lost F01 ctrl0 and the enables. */
+			printf("SWEET TOUCH: F01 status %#x: reconfiguring\n", status);
+			touch_report(0, st.x, st.y);
+			rmi.page = -1;
+			if ((err = rmi_f01_config())) {
+				return err;
+			}
+		}
+	}
+	if (bits & rmi_irq_mask(rmi.f12)) {
+		return rmi_objects();
+	}
+	return 0;
+}
+
+/* OnePlus 6: the panel is the boot video mode (1080x2280), as SweetHID takes it. */
+static void
+touch_panel_from_video(void)
+{
+	PE_Video video;
+
+	bzero(&video, sizeof(video));
+	if (PE_current_console(&video) == 0 && video.v_width >= 16 && video.v_height >= 16 &&
+	    video.v_width <= 8192 && video.v_height <= 8192) {
