+/*
+ * Copy the counters to the registry. Called with no lock held (setProperty takes the registry's
+ * own lock). Unforced calls return at once unless SWEET_GPU_STAT_EVENTS events or a second have
+ * passed, and never wait for another thread that is publishing.
+ */
+static void
+sweet_gpu_stat_publish(bool force, const char *client)
+{
+	SweetGPU *service = gSweetGPUService;
+	uint64_t events = SWEET_STAT_LOAD(gStatEvents), now = mach_absolute_time();
+
+	if (service == NULL || gSweetGPUStatLock == NULL) {
+		return;
+	}
+	if (!force) {
+		uint64_t published = SWEET_STAT_LOAD(gStatPublishedEvents);
+		if (events == published ||
+		    (events - published < SWEET_GPU_STAT_EVENTS &&
+		    now - SWEET_STAT_LOAD(gStatPublishedAt) < gSweetGPUSecondAbs)) {
+			return;
+		}
+		if (!IOLockTryLock(gSweetGPUStatLock)) {
+			return;
+		}
+	} else {
+		IOLockLock(gSweetGPUStatLock);
+	}
+	__atomic_store_n(&gStatPublishedEvents, events, __ATOMIC_RELAXED);
+	__atomic_store_n(&gStatPublishedAt, now, __ATOMIC_RELAXED);
+	if (client != NULL) {
+		strlcpy(gStatLastClient, client, sizeof(gStatLastClient));
+		service->setProperty("SweetGPULastClient", gStatLastClient);
+	}
+	uint64_t faults = 0, hangs = SWEET_STAT_LOAD(gStatHangs);
+	if (!sweet_gpu_get_param(0x09u, &faults)) {     /* MSM_PARAM_FAULTS: SMMU faults seen by sweet_gpu_report() */
+		faults = 0;
+	}
+	service->setProperty("SweetGPUSubmits", (unsigned long long)SWEET_STAT_LOAD(gStatSubmits), 64);
+	service->setProperty("SweetGPUImports", (unsigned long long)SWEET_STAT_LOAD(gStatImports), 64);
+	service->setProperty("SweetGPUClients", (unsigned long long)SWEET_STAT_LOAD(gStatClients), 32);
+	service->setProperty("SweetGPUOpens", (unsigned long long)SWEET_STAT_LOAD(gStatOpens), 64);
+	service->setProperty("SweetGPUFaults", (unsigned long long)(faults + hangs), 64);
+	service->setProperty("SweetGPUHangs", (unsigned long long)hangs, 64);
+	service->setProperty("SweetGPULogLines", (unsigned long long)SWEET_STAT_LOAD(gStatLogLines), 64);
+	service->setProperty("SweetGPULogDropped", (unsigned long long)SWEET_STAT_LOAD(gStatLogDropped), 64);
+	IOLockUnlock(gSweetGPUStatLock);
+}
