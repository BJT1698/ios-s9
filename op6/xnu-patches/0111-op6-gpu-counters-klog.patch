+/*
+ * Selector 0x7f: one line of a user process's log into the kernel's (printf: dmesg and the
+ * persistent log). Control characters become '?', a newline a space; trailing blanks are cut.
+ * SWEET_GPU_LOG_RATE lines per second per process; what is dropped is counted and said once
+ * the next second begins. Takes no GPU lock and needs no GPU.
+ */
+IOReturn
+SweetGPUUserClient::kernelLog(const void *text, uint32_t size)
+{
+	char line[SWEET_GPU_LOG_MAX + 1];
+	const uint8_t *in = (const uint8_t *)text;
+	uint32_t n = 0, dropped = 0;
+	bool print = false;
+
+	if (in == NULL || size == 0) {
+		return kIOReturnBadArgument;
+	}
+	if (size > SWEET_GPU_LOG_MAX) {
+		size = SWEET_GPU_LOG_MAX;
+	}
+	for (uint32_t i = 0; i < size && in[i] != 0; i++) {
+		uint8_t c = in[i];
+		if (c == '\n' || c == '\r' || c == '\t') {
+			c = ' ';
+		} else if (c < 0x20 || c == 0x7f) {
+			c = '?';
+		}
+		line[n++] = (char)c;
+	}
+	while (n > 0 && line[n - 1] == ' ') {
+		n--;
+	}
+	line[n] = 0;
+	if (n == 0) {
+		return kIOReturnSuccess;
+	}
+
+	int pid = proc_selfpid();
+	uint64_t now = mach_absolute_time();
+	if (gSweetGPULogLock == NULL) {
+		return kIOReturnNotReady;
+	}
+	IOLockLock(gSweetGPULogLock);
+	struct sweet_gpu_log_rate *rate = NULL, *oldest = &gLogRate[0];
+	for (uint32_t i = 0; i < SWEET_GPU_LOG_PROCS; i++) {
+		if (gLogRate[i].pid == pid && gLogRate[i].window != 0) {
+			rate = &gLogRate[i];
+			break;
+		}
+		if (gLogRate[i].window < oldest->window) {
+			oldest = &gLogRate[i];
+		}
+	}
+	if (rate == NULL) {
+		rate = oldest;                  /* a new process takes the longest unused slot */
+		bzero(rate, sizeof(*rate));
+		rate->pid = pid;
+		rate->window = now;
+	}
+	if (now - rate->window >= gSweetGPUSecondAbs) {
+		dropped = rate->dropped;
+		rate->window = now;
+		rate->lines = 0;
+		rate->dropped = 0;
+	}
+	if (rate->lines < SWEET_GPU_LOG_RATE) {
+		rate->lines++;
+		print = true;
+	} else {
+		rate->dropped++;
+	}
+	IOLockUnlock(gSweetGPULogLock);
+
+	if (dropped != 0) {
+		printf("sweet-gl[%s]: (%u lines dropped: more than %u a second)\n", fProcName, dropped, SWEET_GPU_LOG_RATE);
+	}
+	if (print) {
+		printf("sweet-gl[%s]: %s\n", fProcName, line);
+		sweet_gpu_stat_event(&gStatLogLines);
+	} else {
+		sweet_gpu_stat_event(&gStatLogDropped);
+	}
+	return kIOReturnSuccess;
+}
