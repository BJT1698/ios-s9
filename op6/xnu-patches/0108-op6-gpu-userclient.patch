+	task_t fTask;
+	struct sweet_gpu_bo *fBOs;
+	uint32_t fNextBO;
+	uint32_t fNextQueue;
+
+	struct sweet_gpu_bo *lookupBO(uint32_t handle);
+	void releaseBOLocked(struct sweet_gpu_bo *b);
+	IOReturn gemNew(struct drm_msm_gem_new *req);
+	IOReturn gemInfo(struct drm_msm_gem_info *req);
+	IOReturn gemSubmit(struct drm_msm_gem_submit *req);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fNextBO = 0;
+	fNextQueue = 0;
+	fBOs = (struct sweet_gpu_bo *)IOMallocZero(SWEET_GPU_MAX_BOS * sizeof(fBOs[0]));
+	return fBOs != NULL;
+}
+
+bool
+SweetGPUUserClient::start(IOService *provider)
+{
+	if (!IOUserClient::start(provider) || !sweet_gpu_ready() || gSweetGPULock == NULL) {
+		return false;
+	}
+	return true;
+}
+
+struct sweet_gpu_bo *
+SweetGPUUserClient::lookupBO(uint32_t handle)
+{
+	if (handle == 0 || handle > SWEET_GPU_MAX_BOS || fBOs == NULL) {
+		return NULL;
+	}
+	struct sweet_gpu_bo *b = &fBOs[handle - 1];
+	return b->mem != NULL ? b : NULL;
+}
+
+void
+SweetGPUUserClient::releaseBOLocked(struct sweet_gpu_bo *b)
+{
+	if (b->mem == NULL) {
+		return;
+	}
+	if (b->fence != 0 && !sweet_gpu_fence_done(b->fence)) {
+		(void)sweet_gpu_wait_locked(b->fence, 200);
+	}
+	sweet_gpu_bo_free(b->pa, b->iova, b->size);
+	b->mem->release();
+	bzero(b, sizeof(*b));
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	if (gSweetGPULock != NULL && fBOs != NULL) {
+		IOLockLock(gSweetGPULock);
+		for (uint32_t i = 0; i < SWEET_GPU_MAX_BOS; i++) {
+			releaseBOLocked(&fBOs[i]);
+		}
+		IOLockUnlock(gSweetGPULock);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fBOs != NULL) {
+		if (gSweetGPULock != NULL) {
+			IOLockLock(gSweetGPULock);
+			for (uint32_t i = 0; i < SWEET_GPU_MAX_BOS; i++) {
+				releaseBOLocked(&fBOs[i]);
+			}
+			IOLockUnlock(gSweetGPULock);
+		}
+		IOFree(fBOs, SWEET_GPU_MAX_BOS * sizeof(fBOs[0]));
+		fBOs = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetGPUUserClient::gemNew(struct drm_msm_gem_new *req)
+{
+	if (req->size == 0 || req->size > (128ull << 20)) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSweetGPULock);
+	uint32_t slot = SWEET_GPU_MAX_BOS;
+	for (uint32_t i = 0; i < SWEET_GPU_MAX_BOS; i++) {
+		uint32_t idx = (fNextBO + i) % SWEET_GPU_MAX_BOS;
+		if (fBOs[idx].mem == NULL) {
+			slot = idx;
+			fNextBO = (idx + 1) % SWEET_GPU_MAX_BOS;
+			break;
+		}
+	}
+	if (slot >= SWEET_GPU_MAX_BOS) {
+		IOLockUnlock(gSweetGPULock);
+		return kIOReturnNoResources;
+	}
+	uint64_t pa = 0, iova = 0;
+	uint32_t actual = 0;
+	if (sweet_gpu_bo_alloc((uint32_t)req->size, req->flags, &pa, &iova, &actual) != 0) {
+		IOLockUnlock(gSweetGPULock);
+		return kIOReturnNoMemory;
+	}
+	IOMemoryDescriptor *mem = IOMemoryDescriptor::withAddressRange(
+	    pa, actual,
+	    kIODirectionInOut | kIOMemoryMapperNone |
+	    (kIOWriteCombineCache << kIOMemoryBufferCacheShift),
+	    TASK_NULL);
+	if (mem == NULL) {
+		sweet_gpu_bo_free(pa, iova, actual);
+		IOLockUnlock(gSweetGPULock);
+		return kIOReturnNoMemory;
+	}
+	struct sweet_gpu_bo *b = &fBOs[slot];
+	b->mem = mem;
+	b->pa = pa;
+	b->iova = iova;
+	b->size = actual;
+	b->flags = req->flags;
+	b->fence = 0;
+	req->handle = slot + 1;
+	IOLockUnlock(gSweetGPULock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetGPUUserClient::gemInfo(struct drm_msm_gem_info *req)
+{
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(gSweetGPULock);
+	struct sweet_gpu_bo *b = lookupBO(req->handle);
+	if (b == NULL) {
+		IOLockUnlock(gSweetGPULock);
+		return kIOReturnBadArgument;
+	}
+	switch (req->info) {
+	case MSM_INFO_GET_OFFSET:
+		if (req->len != 0 && req->len < sizeof(uint64_t)) {
+			ret = kIOReturnBadArgument;
+		} else {
+			req->value = (uint64_t)req->handle << 16;
+			req->len = sizeof(uint64_t);
+		}
+		break;
+	case MSM_INFO_GET_IOVA:
+		if (req->len != 0 && req->len < sizeof(uint64_t)) {
+			ret = kIOReturnBadArgument;
+		} else {
+			req->value = b->iova;
+			req->len = sizeof(uint64_t);
+		}
+		break;
+	case MSM_INFO_SET_NAME:
+		break;
+	case MSM_INFO_GET_FLAGS:
+		if (req->len != 0 && req->len < sizeof(uint64_t)) {
+			ret = kIOReturnBadArgument;
+		} else {
+			req->value = b->flags;
+			req->len = sizeof(uint64_t);
+		}
+		break;
+	default:
+		ret = kIOReturnBadArgument;
+		break;
+	}
+	IOLockUnlock(gSweetGPULock);
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::gemSubmit(struct drm_msm_gem_submit *req)
+{
+	if (req->nr_cmds == 0 || req->nr_cmds > SWEET_GPU_MAX_CMDS ||
+	    req->nr_bos > SWEET_GPU_MAX_BOS || req->cmds == 0 ||
+	    (req->nr_bos != 0 && req->bos == 0)) {
+		return kIOReturnBadArgument;
+	}
+	size_t bos_bytes = (size_t)req->nr_bos * sizeof(struct drm_msm_gem_submit_bo);
+	size_t cmds_bytes = (size_t)req->nr_cmds * sizeof(struct drm_msm_gem_submit_cmd);
+	struct drm_msm_gem_submit_bo *bos = NULL;
+	if (bos_bytes != 0) {
+		bos = (struct drm_msm_gem_submit_bo *)IOMallocData(bos_bytes);
+		if (bos == NULL) {
+			return kIOReturnNoMemory;
+		}
+		if (copyin((user_addr_t)req->bos, bos, bos_bytes) != 0) {
+			IOFreeData(bos, bos_bytes);
+			return kIOReturnVMError;
+		}
+	}
+	struct drm_msm_gem_submit_cmd *cmds = (struct drm_msm_gem_submit_cmd *)IOMallocData(cmds_bytes);
+	if (cmds == NULL) {
+		if (bos != NULL) {
+			IOFreeData(bos, bos_bytes);
+		}
+		return kIOReturnNoMemory;
+	}
+	if (copyin((user_addr_t)req->cmds, cmds, cmds_bytes) != 0) {
+		IOFreeData(cmds, cmds_bytes);
+		if (bos != NULL) {
+			IOFreeData(bos, bos_bytes);
+		}
+		return kIOReturnVMError;
+	}
+
+	uint64_t ib_iovas[SWEET_GPU_MAX_CMDS];
+	uint32_t ib_dwords[SWEET_GPU_MAX_CMDS];
+	uint32_t ib_count = 0;
+	IOReturn ret = kIOReturnSuccess;
+
+	IOLockLock(gSweetGPULock);
+	for (uint32_t i = 0; i < req->nr_bos; i++) {
+		if (lookupBO(bos[i].handle) == NULL) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+	}
+	for (uint32_t i = 0; ret == kIOReturnSuccess && i < req->nr_cmds; i++) {
+		if (cmds[i].type != MSM_SUBMIT_CMD_BUF) {
+			continue;
+		}
+		if (cmds[i].submit_idx >= req->nr_bos || cmds[i].nr_relocs != 0 ||
+		    cmds[i].size == 0 || (cmds[i].size & 3u) != 0 ||
+		    (cmds[i].submit_offset & 3u) != 0) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		struct sweet_gpu_bo *b = lookupBO(bos[cmds[i].submit_idx].handle);
+		if (b == NULL || (uint64_t)cmds[i].submit_offset + cmds[i].size > b->size) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		ib_iovas[ib_count] = b->iova + cmds[i].submit_offset;
+		ib_dwords[ib_count++] = cmds[i].size / 4u;
+	}
+	if (ret == kIOReturnSuccess) {
+		uint32_t fence = 0;
+		if (sweet_gpu_submit(ib_iovas, ib_dwords, ib_count, &fence) != 0 || fence == 0) {
+			ret = kIOReturnTimeout;
+		} else {
+			req->fence = fence;
+			if (req->flags & MSM_SUBMIT_FENCE_FD_OUT) {
+				req->fence_fd = -1;
+			}
+			for (uint32_t i = 0; i < req->nr_bos; i++) {
+				struct sweet_gpu_bo *b = lookupBO(bos[i].handle);
+				if (b != NULL) {
+					b->fence = fence;
+				}
+			}
+		}
+	}
+	IOLockUnlock(gSweetGPULock);
+
+	IOFreeData(cmds, cmds_bytes);
+	if (bos != NULL) {
+		IOFreeData(bos, bos_bytes);
+	}
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOReturn ret = kIOReturnBadArgument;
+	uint32_t handle = (type > SWEET_GPU_MAX_BOS && (type & 0xffffu) == 0) ? (type >> 16) : type;
+
+	IOLockLock(gSweetGPULock);
+	struct sweet_gpu_bo *b = lookupBO(handle);
+	if (b != NULL) {
+		b->mem->retain();
+		*memory = b->mem;
+		*options = kIOMapWriteCombineCache;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSweetGPULock);
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	union {
+		struct drm_msm_param param;
+		struct drm_msm_gem_new gemNew;
+		struct drm_msm_gem_info gemInfo;
+		struct drm_msm_gem_cpu_prep cpuPrep;
+		struct drm_msm_gem_submit submit;
+		struct drm_msm_wait_fence waitFence;
+		struct drm_msm_gem_madvise madvise;
+		struct drm_msm_submitqueue queue;
+		struct drm_msm_submitqueue_query query;
+		struct drm_gem_close close;
+	} r;
+	size_t size = args->structureInputSize;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t zero = 0;
+
+	if (!sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	if (args->structureInput == NULL || size == 0 || size > sizeof(r) || fBOs == NULL) {
+		return kIOReturnBadArgument;
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	switch (selector) {
+	case kMsmGetParam:
+		if (sweet_gpu_get_param(r.param.param, &r.param.value)) {
+			r.param.len = sizeof(uint64_t);
+		} else {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case kMsmSetParam:
+	case kMsmGemCpuFini:
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmGemNew:
+		ret = gemNew(&r.gemNew);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+	case kMsmGemCpuPrep: {
+		IOLockLock(gSweetGPULock);
+		struct sweet_gpu_bo *b = lookupBO(r.cpuPrep.handle);
+		uint32_t fence = b != NULL ? b->fence : sweet_gpu_last_fence();
+		uint64_t ms = (r.cpuPrep.op & MSM_PREP_NOSYNC) ? 0 : sweet_gpu_timeout_ms(&r.cpuPrep.timeout);
+		if (fence != 0 && !sweet_gpu_wait_locked(fence, ms)) {
+			ret = kIOReturnBusy;
+		}
+		IOLockUnlock(gSweetGPULock);
+		break;
+	}
+	case kMsmGemSubmit:
+		ret = gemSubmit(&r.submit);
+		break;
+	case kMsmWaitFence: {
+		IOLockLock(gSweetGPULock);
+		if ((int32_t)(r.waitFence.fence - sweet_gpu_last_fence()) > 0) {
+			ret = kIOReturnBadArgument;
+		} else if (!sweet_gpu_wait_locked(r.waitFence.fence, sweet_gpu_timeout_ms(&r.waitFence.timeout))) {
+			ret = kIOReturnTimeout;
+		}
+		IOLockUnlock(gSweetGPULock);
+		break;
+	}
+	case kMsmGemMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueQuery:
+		if (r.query.data != 0 && r.query.len >= sizeof(zero)) {
+			if (copyout(&zero, (user_addr_t)r.query.data, sizeof(zero)) != 0) {
+				ret = kIOReturnVMError;
+			}
+		}
+		break;
+	case kDrmGemClose: {
+		IOLockLock(gSweetGPULock);
+		struct sweet_gpu_bo *b = lookupBO(r.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnBadArgument;
+		} else {
+			releaseBOLocked(b);
+		}
+		IOLockUnlock(gSweetGPULock);
+		break;
+	}
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		if (args->structureOutputSize > size) {
+			args->structureOutputSize = (uint32_t)size;
+		}
+		memcpy(args->structureOutput, &r, args->structureOutputSize);
+	}
+	return ret;
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
