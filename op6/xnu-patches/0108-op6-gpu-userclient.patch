+/* ---- 8. Milestone G2: BO allocator, IB submit, fence wait, msm uAPI params ---- */
+
+#define BO_MAX_PAGES		65536u		/* up to 256 MiB carve-out in 4K pages */
+static uint64_t bo_bmap[BO_MAX_PAGES / 64];
+static uint64_t bo_base_pa;
+static uint32_t bo_total_pages, bo_used_pages;
+static uint32_t gpu_fence, gpu_faults;
+static int gpu_ready;
+
+static void
+bo_init(void)
+{
+	uint32_t off = (g.dma_used + 0x3fffu) & ~0x3fffu;
+
+	bzero(bo_bmap, sizeof(bo_bmap));
+	if (off >= g.dma_size) {
+		bo_base_pa = 0;
+		bo_total_pages = 0;
+		return;
+	}
+	bo_base_pa = g.dma_pa + off;
+	bo_total_pages = (g.dma_size - off) / 4096u;
+	if (bo_total_pages > BO_MAX_PAGES) {
+		bo_total_pages = BO_MAX_PAGES;
+	}
+	bo_used_pages = 0;
+}
+
+int
+sweet_gpu_ready(void)
+{
+	return gpu_ready;
+}
+
+int
+sweet_gpu_get_param(uint32_t param, uint64_t *val)
+{
+	switch (param) {
+	case 0x01:	/* MSM_PARAM_GPU_ID */
+		*val = 630;
+		return 1;
+	case 0x02:	/* MSM_PARAM_GMEM_SIZE (1 MiB on Adreno 630) */
+		*val = 1024ull * 1024ull;
+		return 1;
+	case 0x03:	/* MSM_PARAM_CHIP_ID (Adreno 630 rev 2) */
+		*val = 0x06030002ull;
+		return 1;
+	case 0x04:	/* MSM_PARAM_MAX_FREQ */
+		*val = (uint64_t)gpu_khz[OPP_BOOT] * 1000ull;
+		return 1;
+	case 0x05:	/* MSM_PARAM_TIMESTAMP */
+		*val = mach_absolute_time();
+		return 1;
+	case 0x06:	/* MSM_PARAM_GMEM_BASE */
+		*val = 0x00100000ull;
+		return 1;
+	case 0x07:	/* MSM_PARAM_PRIORITIES / NR_RINGS */
+		*val = 1;
+		return 1;
+	case 0x08:	/* MSM_PARAM_PP_PGTABLE */
+	case 0x0a:	/* MSM_PARAM_SUSPENDS */
+	case 0x11:	/* MSM_PARAM_RAYTRACING */
+		*val = 0;
+		return 1;
+	case 0x09:	/* MSM_PARAM_FAULTS */
+		*val = gpu_faults;
+		return 1;
+	case 0x10:	/* MSM_PARAM_HIGHEST_BANK_BIT (SDM845: bit 15) */
+		*val = 15;
+		return 1;
+	case 0x12:	/* MSM_PARAM_UBWC_SWIZZLE */
+		*val = 6;
+		return 1;
+	case 0x13:	/* MSM_PARAM_MACROTILE_MODE */
+		*val = 0;
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static int
+bmap_test(uint32_t p)
+{
+	return (bo_bmap[p >> 6] >> (p & 63)) & 1;
+}
+
+static void
+bmap_set(uint32_t p)
+{
+	bo_bmap[p >> 6] |= 1ull << (p & 63);
+}
+
+static void
+bmap_clr(uint32_t p)
+{
+	bo_bmap[p >> 6] &= ~(1ull << (p & 63));
+}
+
+/*
+ * Allocate a BO from the carve-out bitmap (16K-aligned for XNU's 16K VM
+ * device pager, mapped with 4K PTEs in the GPU SMMU at VA_BO_BASE + p*4K).
+ */
+int
+sweet_gpu_bo_alloc(uint32_t size, uint32_t flags, uint64_t *pa_out, uint64_t *iova_out, uint32_t *actual_size_out)
+{
+	if (!gpu_ready || size == 0 || size > 0x10000000u) {
+		return -1;
+	}
+	uint32_t actual = (size + 0x3fffu) & ~0x3fffu;
+	uint32_t npages = actual / 4096u;
+	if (npages > bo_total_pages - bo_used_pages) {
+		return -1;
+	}
+	for (uint32_t p = 0; p + npages <= bo_total_pages; p += 4) {
+		uint32_t k = 0;
+		while (k < npages && !bmap_test(p + k)) {
+			k++;
+		}
+		if (k < npages) {
+			p += k & ~3u;
+			continue;
+		}
+		uint64_t pa = bo_base_pa + (uint64_t)p * 4096ull;
+		uint64_t iova = VA_BO_BASE + (uint64_t)p * 4096ull;
+		uint64_t attr = PTE_RW | ((flags & 2u) ? PTE_RDONLY : 0);
+		zero(dma_va(pa), actual);
+		if (!pt_map(&gpu_pt, iova, pa, actual, attr)) {
+			pt_unmap(&gpu_pt, iova, actual);
+			cb_tlb_inv(gcbbase);
+			return -1;
+		}
+		cb_tlb_inv(gcbbase);
+		for (uint32_t i = 0; i < npages; i++) {
+			bmap_set(p + i);
+		}
+		bo_used_pages += npages;
+		*pa_out = pa;
+		*iova_out = iova;
+		*actual_size_out = actual;
+		return 0;
+	}
+	return -1;
+}
+
+void
+sweet_gpu_bo_free(uint64_t pa, uint64_t iova, uint32_t size)
+{
+	if (!gpu_ready || pa < bo_base_pa || size == 0) {
+		return;
+	}
+	uint32_t p = (uint32_t)((pa - bo_base_pa) / 4096ull);
+	uint32_t npages = ((size + 0x3fffu) & ~0x3fffu) / 4096u;
+	if (p + npages > bo_total_pages) {
+		return;
+	}
+	pt_unmap(&gpu_pt, iova, npages * 4096u);
+	cb_tlb_inv(gcbbase);
+	for (uint32_t i = 0; i < npages; i++) {
+		if (bmap_test(p + i)) {
+			bmap_clr(p + i);
+			if (bo_used_pages > 0) {
+				bo_used_pages--;
+			}
+		}
+	}
+}
+
+uint32_t
+sweet_gpu_last_fence(void)
+{
+	return gpu_fence;
+}
+
+int
+sweet_gpu_fence_done(uint32_t fence)
+{
+	if (!gpu_ready) {
+		return 0;
+	}
+	uint32_t done = ((volatile uint32_t *)scratch)[SCR_FENCE];
+	dmb_ld();
+	return (int32_t)(done - fence) >= 0;
+}
+
+void
+sweet_gpu_report(const char *why)
+{
+	if (!gpu_ready) {
+		return;
+	}
+	uint32_t done = ((volatile uint32_t *)scratch)[SCR_FENCE];
+	LOG("report (%s): fence=%u/%u rptr=%u shadow=%u wptr=%u st=%08x i0=%08x flt=%08x ci=%08x pr=%08x\n",
+	    why, done, gpu_fence, gr(CP_RB_RPTR), ((volatile uint32_t *)scratch)[SCR_SHADOW], wp,
+	    gr(RBBM_STATUS), gr(RBBM_INT_0_STATUS), gr(CP_HW_FAULT), gr(CP_INTERRUPT_STATUS),
+	    gr(CP_PROTECT_STATUS));
+	LOG("report: ib1=%llx rem=%u ib2=%llx rem=%u\n",
+	    ((uint64_t)gr(CP_IB1_BASE + 1) << 32) | gr(CP_IB1_BASE), gr(CP_IB1_REM_SIZE),
+	    ((uint64_t)gr(CP_IB2_BASE + 1) << 32) | gr(CP_IB2_BASE), gr(CP_IB2_REM_SIZE));
+	if (faulted(why)) {
+		gpu_faults++;
+		if (gcbbase) {
+			wr(SMMU(gcbbase + CB_FSR), FSR_ALL);
+		}
+	}
+}
+
+int
+sweet_gpu_submit(const uint64_t *ib_iovas, const uint32_t *ib_dwords, uint32_t nr_ibs, uint32_t *fence_out)
+{
+	if (!gpu_ready || nr_ibs > 128) {
+		return -1;
+	}
+	uint32_t wanted = 20 + 4 * nr_ibs, room = 0;
+	uint64_t t0 = us_now();
+	for (;;) {
+		room = (gr(CP_RB_RPTR) + RING_DW - wp - 1) % RING_DW;
+		if (room >= wanted || us_now() - t0 > 500000) {
+			break;
+		}
+	}
+	if (room < wanted) {
+		sweet_gpu_report("ring full");
+		return -1;
+	}
+	if (++gpu_fence == 0) {
+		gpu_fence = 1;
+	}
+	pkt7(CP_EVENT_WRITE, 1);
+	emit(EVENT_INVALIDATE_DEPTH);
+	pkt7(CP_EVENT_WRITE, 1);
+	emit(EVENT_INVALIDATE_COLOR);
+	for (uint32_t i = 0; i < nr_ibs; i++) {
+		pkt7(CP_INDIRECT_BUFFER, 3);
+		emit((uint32_t)ib_iovas[i]);
+		emit((uint32_t)(ib_iovas[i] >> 32));
+		emit(ib_dwords[i]);
+	}
+	pkt7(CP_WAIT_FOR_IDLE, 0);
+	pkt7(CP_EVENT_WRITE, 4);
+	emit(EVENT_CACHE_FLUSH);
+	emit(VA_SCRATCH + 4 * SCR_FENCE);
+	emit(0);
+	emit(gpu_fence);
+	flush();
+	*fence_out = gpu_fence;
+	return 0;
+}
