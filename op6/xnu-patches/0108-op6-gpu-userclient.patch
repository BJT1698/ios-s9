+#define MSM_INFO_GET_OFFSET     0u
+#define MSM_INFO_GET_IOVA       1u
+#define MSM_INFO_SET_NAME       2u
+#define MSM_INFO_GET_FLAGS      5u
+#define MSM_PREP_NOSYNC         0x04u
+#define MSM_SUBMIT_CMD_BUF      1u
+#define MSM_SUBMIT_FENCE_FD_OUT 0x20000000u
+
+#define SWEET_GPU_MAX_BOS       1024u
+#define SWEET_GPU_MAX_CMDS      128u
+#define SWEET_GPU_PATIENCE_MS   5000u
+
+struct sweet_gpu_bo {
+	IOMemoryDescriptor *mem;
+	uint64_t pa;
+	uint64_t iova;
+	uint32_t size;
+	uint32_t flags;
