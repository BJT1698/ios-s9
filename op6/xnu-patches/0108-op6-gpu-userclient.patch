+};
+
+static uint64_t
+sweet_gpu_timeout_ms(const struct msm_timespec *ts)
+{
+	if (ts->tv_sec <= 0 && ts->tv_nsec <= 0) {
+		return 0;
+	}
+	/* Allow small relative timeouts (e.g. tv_sec = 1..25 from simple test tools) */
+	if (ts->tv_sec > 0 && ts->tv_sec <= 25 && ts->tv_nsec >= 0 && ts->tv_nsec < 1000000000ll) {
+		uint64_t ms = (uint64_t)ts->tv_sec * 1000ull + (uint64_t)ts->tv_nsec / 1000000ull;
+		return ms > SWEET_GPU_PATIENCE_MS ? SWEET_GPU_PATIENCE_MS : ms;
+	}
+	int64_t end = 0;
+	if (__builtin_mul_overflow(ts->tv_sec, (int64_t)NSEC_PER_SEC, &end) ||
+	    __builtin_add_overflow(end, ts->tv_nsec, &end)) {
+		return ts->tv_sec > 0 ? SWEET_GPU_PATIENCE_MS : 0;
+	}
+	if (end <= 0) {
+		return 0;
+	}
+	uint64_t now_cont = 0, now_abs = 0;
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now_cont);
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now_abs);
+	int64_t left_cont = end - (int64_t)now_cont;
+	int64_t left_abs = end - (int64_t)now_abs;
+	int64_t left = left_cont > left_abs ? left_cont : left_abs;
+	if (left <= 0) {
+		return 0;
+	}
+	uint64_t ms = (uint64_t)left / NSEC_PER_MSEC;
+	return ms > SWEET_GPU_PATIENCE_MS ? SWEET_GPU_PATIENCE_MS : ms;
+}
+
+/* Wait for fence completion with gSweetGPULock held (released while sleeping). */
+static bool
+sweet_gpu_wait_locked(uint32_t fence, uint64_t ms)
+{
+	uint64_t began = mach_absolute_time(), patience = 0;
+
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &patience);
+	for (;;) {
+		if (sweet_gpu_fence_done(fence)) {
+			return true;
+		}
+		if (mach_absolute_time() - began >= patience || gSweetGPUReported) {
+			break;
+		}
+		IOLockUnlock(gSweetGPULock);
+		delay_for_interval(50, NSEC_PER_USEC);
+		IOLockLock(gSweetGPULock);
+	}
+	if (ms >= 500 && !gSweetGPUReported) {
+		gSweetGPUReported = true;
+		sweet_gpu_report("wait timeout");
+	}
+	return false;
+}
