 {
+   if (!bo)
+      return;
+
    if (bo->funcs->upload) {
       bo->funcs->upload(bo, src, off, len);
       return;
    }
 
-   memcpy((uint8_t *)fd_bo_map_for_upload(bo) + off, src, len);
+   void *map = fd_bo_map_for_upload(bo);
+   if (!map) {
+      fd_device_mark_oom(bo->dev);
