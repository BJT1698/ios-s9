+void
+fd_oom_note_skip(const char *where)
+{
+   static unsigned skipped;
+   unsigned n = p_atomic_inc_return(&skipped);
+   if (n == 1) {
+      mesa_loge("freedreno: skipping %s with NULL BO after GPU OOM (first skip)",
+                where);
+#ifdef __APPLE__
+      sweet_drm_log("mesa: skipping %s with NULL BO after GPU OOM (first skip; "
+                    "further skips counted silently)",
+                    where);
+#endif
+   }
+}
+
+static bool
+shader_stage_has_null_bo(struct fd_context *ctx, enum pipe_shader_type s) assert_dt
+{
+   u_foreach_bit (i, ctx->constbuf[s].enabled_mask) {
+      struct pipe_constant_buffer *cb = &ctx->constbuf[s].cb[i];
+      if (!cb->user_buffer && fd_rsc_has_null_bo(cb->buffer))
+         return true;
+   }
+
+   u_foreach_bit (i, ctx->tex[s].valid_textures) {
+      struct pipe_sampler_view *sv = ctx->tex[s].textures[i];
+      if (sv && fd_rsc_has_null_bo(sv->texture))
+         return true;
+   }
+
+   u_foreach_bit (i, ctx->shaderbuf[s].enabled_mask) {
+      if (fd_rsc_has_null_bo(ctx->shaderbuf[s].sb[i].buffer))
+         return true;
+   }
+
+   u_foreach_bit (i, ctx->shaderimg[s].enabled_mask) {
+      if (fd_rsc_has_null_bo(ctx->shaderimg[s].si[i].resource))
+         return true;
+   }
+
+   return false;
+}
+
+static bool
+draw_has_null_bo(struct fd_context *ctx, const struct pipe_draw_info *info,
+                 const struct pipe_draw_indirect_info *indirect) assert_dt
+{
+   struct pipe_framebuffer_state *pfb = &ctx->framebuffer;
+
+   for (unsigned i = 0; i < pfb->nr_cbufs; i++) {
+      if (pfb->cbufs[i] && fd_rsc_has_null_bo(pfb->cbufs[i]->texture))
+         return true;
+   }
+   if (pfb->zsbuf && fd_rsc_has_null_bo(pfb->zsbuf->texture))
+      return true;
+
+   if (info->index_size && !info->has_user_indices &&
+       fd_rsc_has_null_bo(info->index.resource))
+      return true;
+
+   if (indirect) {
+      if (fd_rsc_has_null_bo(indirect->buffer) ||
+          fd_rsc_has_null_bo(indirect->indirect_draw_count))
+         return true;
+      if (indirect->count_from_stream_output) {
+         struct fd_stream_output_target *so =
+            fd_stream_output_target(indirect->count_from_stream_output);
+         if (fd_rsc_has_null_bo(so->offset_buf))
+            return true;
+      }
+   }
+
+   u_foreach_bit (i, ctx->vtx.vertexbuf.enabled_mask) {
+      struct pipe_vertex_buffer *vb = &ctx->vtx.vertexbuf.vb[i];
+      if (!vb->is_user_buffer && fd_rsc_has_null_bo(vb->buffer.resource))
+         return true;
+   }
+
+   for (unsigned i = 0; i < ctx->streamout.num_targets; i++) {
+      struct fd_stream_output_target *target =
+         fd_stream_output_target(ctx->streamout.targets[i]);
+      if (target && (fd_rsc_has_null_bo(target->base.buffer) ||
+                     fd_rsc_has_null_bo(target->offset_buf)))
+         return true;
+   }
+
+   u_foreach_bit (s, ctx->bound_shader_stages) {
+      if (shader_stage_has_null_bo(ctx, s))
+         return true;
+   }
+
+   list_for_each_entry (struct fd_acc_query, aq, &ctx->acc_active_queries, node) {
+      if (fd_rsc_has_null_bo(aq->prsc))
+         return true;
+   }
+
+   return false;
+}
+
+static bool
+clear_has_null_bo(struct fd_context *ctx, unsigned buffers) assert_dt
+{
+   struct pipe_framebuffer_state *pfb = &ctx->framebuffer;
+
+   if (buffers & PIPE_CLEAR_COLOR) {
+      for (unsigned i = 0; i < pfb->nr_cbufs; i++) {
+         if ((buffers & (PIPE_CLEAR_COLOR0 << i)) && pfb->cbufs[i] &&
+             fd_rsc_has_null_bo(pfb->cbufs[i]->texture))
+            return true;
+      }
+   }
+
+   if ((buffers & (PIPE_CLEAR_DEPTH | PIPE_CLEAR_STENCIL)) && pfb->zsbuf &&
+       fd_rsc_has_null_bo(pfb->zsbuf->texture))
