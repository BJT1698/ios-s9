+      if (fd_rsc_oom_null_bo(dev, ctx->global_bindings.buf[i]))
+         return "fd_launch_grid(global)";
+   }
+   if (fd_rsc_oom_null_bo(dev, info->indirect))
+      return "fd_launch_grid(indirect)";
