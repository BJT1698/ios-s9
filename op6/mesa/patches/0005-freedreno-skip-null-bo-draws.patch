 bool
@@ -883,3 +893,106 @@ fd_bo_state(struct fd_bo *bo)
    return FD_BO_STATE_BUSY;
 }
 
+bool
+fd_device_oom(struct fd_device *dev)
+{
+   return dev && p_atomic_read(&dev->oom_alloc_fails) > 0;
+}
+
+void
+fd_device_mark_oom(struct fd_device *dev)
+{
+   if (dev)
+      p_atomic_inc(&dev->oom_alloc_fails);
+}
+
+static simple_mtx_t oom_log_lock = SIMPLE_MTX_INITIALIZER;
+static struct {
+   bool atexit_registered;
+   bool first_logged;
+   unsigned total_skips;
+   unsigned alloc_fails;
+   struct {
+      const char *where;
+      unsigned count;
+   } reasons[16];
+   unsigned nr_reasons;
+} oom_stats;
+
+static void
+fd_oom_atexit_log(void)
+{
+   char buf[256];
+   size_t pos = 0;
+   unsigned total = 0;
+   unsigned fails = 0;
+
+   simple_mtx_lock(&oom_log_lock);
+   if (oom_stats.total_skips > 1) {
+      total = oom_stats.total_skips;
+      fails = oom_stats.alloc_fails;
+      buf[0] = '\0';
+      for (unsigned i = 0; i < oom_stats.nr_reasons && pos + 2 < sizeof(buf); i++) {
+         int n = snprintf(buf + pos, sizeof(buf) - pos, "%s%s=%u",
+                          i ? ", " : "", oom_stats.reasons[i].where,
+                          oom_stats.reasons[i].count);
+         if (n > 0)
+            pos += MIN2((size_t)n, sizeof(buf) - pos - 1);
+      }
+   }
+   simple_mtx_unlock(&oom_log_lock);
+
+   if (total > 1) {
+      mesa_loge("mesa: GPU OOM skip summary (pid=%d): skipped=%u oom_alloc_fails=%u [%s]",
+                (int)getpid(), total, fails, buf);
+#ifdef __APPLE__
+      sweet_drm_log("mesa: GPU OOM skip summary (pid=%d): skipped=%u oom_alloc_fails=%u [%s]",
+                    (int)getpid(), total, fails, buf);
+#endif
+   }
+}
+
+void
+fd_oom_note_skip(struct fd_device *dev, const char *where)
+{
+   if (!fd_device_oom(dev))
+      return;
+
+   unsigned fails = p_atomic_read(&dev->oom_alloc_fails);
+   bool log_first = false;
+
+   simple_mtx_lock(&oom_log_lock);
+   oom_stats.total_skips++;
+   oom_stats.alloc_fails = fails;
+   for (unsigned i = 0; i < oom_stats.nr_reasons; i++) {
+      if (strcmp(oom_stats.reasons[i].where, where) == 0) {
+         oom_stats.reasons[i].count++;
+         goto found;
+      }
+   }
+   if (oom_stats.nr_reasons < ARRAY_SIZE(oom_stats.reasons)) {
+      oom_stats.reasons[oom_stats.nr_reasons].where = where;
+      oom_stats.reasons[oom_stats.nr_reasons].count = 1;
+      oom_stats.nr_reasons++;
+   }
+found:
+   if (!oom_stats.atexit_registered) {
+      oom_stats.atexit_registered = true;
+      atexit(fd_oom_atexit_log);
+   }
+   if (!oom_stats.first_logged) {
+      oom_stats.first_logged = true;
+      log_first = true;
+   }
+   simple_mtx_unlock(&oom_log_lock);
+
+   if (log_first) {
+      mesa_loge("mesa: skipping %s after GPU OOM (oom_alloc_fails=%u, skipped=1)",
+                where, fails);
+#ifdef __APPLE__
+      sweet_drm_log("mesa: skipping %s after GPU OOM (oom_alloc_fails=%u, skipped=1)",
+                    where, fails);
+#endif
+   }
+}
+
