    if (render_condition_enabled && !fd_render_condition_check(pctx))
       return;
 
+   if (ps && fd_rsc_has_null_bo(ps->texture)) {
+      fd_oom_note_skip("clear_depth_stencil");
+      return;
+   }
+
    fd_blitter_clear_depth_stencil(pctx, ps, buffers,
                                   depth, stencil, x, y, w, h,
                                   render_condition_enabled);
@@ -564,6 +736,11 @@ fd_launch_grid(struct pipe_context *pctx,
    if (!fd_render_condition_check(pctx))
       return;
 
+   if (launch_grid_has_null_bo(ctx, info)) {
+      fd_oom_note_skip("launch_grid");
+      return;
+   }
+
    batch = fd_context_batch_nondraw(ctx);
    fd_batch_reference(&save_batch, ctx->batch);
    fd_batch_reference(&ctx->batch, batch);
