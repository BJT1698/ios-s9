@@ -870,8 +882,9 @@ resource_transfer_map(struct pipe_context *pctx, struct pipe_resource *prsc,
                      prsc, level, usage, box->width, box->height, box->x, box->y);
    }
 
-   if (usage & PIPE_MAP_DISCARD_WHOLE_RESOURCE) {
