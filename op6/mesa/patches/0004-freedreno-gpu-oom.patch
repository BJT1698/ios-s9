freedreno: survive GPU memory exhaustion (OnePlus 6 / SweetGPU)

With a 64 MiB SweetGPU carve-out backboardd died in glTexImage2D:
st_TexImage -> fd_resource_create -> realloc_bo -> fd_bo_new -> bo_new ->
fd_bo_heap_alloc, whose heap block fd_bo_new() returned NULL (GEM_NEW
refused), then fd_bo_ref(NULL) -> SIGSEGV at 0x14.

- fd_bo_heap_alloc(): a block that cannot be allocated gives its range
  back and returns NULL (bo_new() then tries a dedicated BO).
- bo_new(): when the kernel refuses GEM_NEW, purge the BO caches
  (fd_device_purge()) and retry exactly once; still failing -> NULL,
  logged (mesa_loge + kernel log via sweet_drm_log on Apple), rate-limited.
- fd_bo_cache_cleanup(): time 0 (purge) is never skipped (upstream
  skipped it when the previous cleanup also had time 0).
- realloc_bo(): allocate the new BO before dropping the old one and
  report failure; resource creation then fails (state tracker raises
  GL_OUT_OF_MEMORY) and a DISCARD_WHOLE_RESOURCE map whose BO cannot be
  replaced keeps the old BO and synchronizes like a normal map.
- fd_bo_new(): do not name a NULL BO in !NDEBUG builds.

Applies after 0001-0003. Mesa is MIT licensed; this patch is too.

diff --git a/src/freedreno/drm/freedreno_bo.c b/src/freedreno/drm/freedreno_bo.c
index cfca4d0..085f3a9 100644
--- a/src/freedreno/drm/freedreno_bo.c
+++ b/src/freedreno/drm/freedreno_bo.c
@@ -142,8 +142,31 @@ bo_new(struct fd_device *dev, uint32_t size, uint32_t flags,
       return bo;
 
    bo = dev->funcs->bo_new(dev, size, flags);
-   if (!bo)
-      return NULL;
+   if (!bo) {
+      /* Out of GPU memory (SweetGPU: GEM_NEW -> ENOMEM when the carve-out or the
+       * GPU page-table pool is exhausted). The BO caches may hold idle buffers
+       * the kernel still counts as used: free them all and try exactly once
+       * more. table_lock is not held here (fd_bo_fini_common() takes it).
+       */
+      int err = errno;
+      fd_device_purge(dev);
+      bo = dev->funcs->bo_new(dev, size, flags);
+      if (!bo) {
+         static unsigned failures;
+         unsigned n = p_atomic_inc_return(&failures);
+         if (n <= 32 || (n % 64) == 0) {
+            mesa_loge("GPU memory exhausted: %u-byte BO (flags 0x%x) failed: %s, "
+                      "also after purging the BO caches (failure #%u)",
+                      size, flags, strerror(err), n);
+#ifdef __APPLE__
+            sweet_drm_log("mesa: GPU memory exhausted: %u-byte BO (flags 0x%x) failed: %s, "
+                          "also after purging the BO caches (failure #%u): GL_OUT_OF_MEMORY",
+                          size, flags, strerror(err), n);
+#endif
+         }
+         return NULL;
+      }
+   }
 
    simple_mtx_lock(&table_lock);
    /* add ourself into the handle table: */
diff --git a/src/freedreno/drm/freedreno_bo_cache.c b/src/freedreno/drm/freedreno_bo_cache.c
index a656267..de71390 100644
--- a/src/freedreno/drm/freedreno_bo_cache.c
+++ b/src/freedreno/drm/freedreno_bo_cache.c
@@ -127,7 +127,11 @@ fd_bo_cache_cleanup(struct fd_bo_cache *cache, time_t time)
 {
    int i, cnt = 0;
 
-   if (cache->time == time)
+   /* time == 0 is a purge (fd_device_purge()): never skipped. Upstream returned here
+    * whenever the last cleanup had the same time, so a purge right after another
+    * purge (or before the first timed cleanup, cache->time == 0) did nothing.
+    */
+   if (time && cache->time == time)
       return;
 
    struct list_head freelist;
diff --git a/src/freedreno/drm/freedreno_bo_heap.c b/src/freedreno/drm/freedreno_bo_heap.c
index 5ec17bc..a8e9a15 100644
--- a/src/freedreno/drm/freedreno_bo_heap.c
+++ b/src/freedreno/drm/freedreno_bo_heap.c
@@ -221,6 +221,11 @@ fd_bo_heap_alloc(struct fd_bo_heap *heap, uint32_t size, uint32_t flags)
    }
 
    struct sa_bo *s = calloc(1, sizeof(*s));
+   if (!s) {
+      util_vma_heap_free(&heap->heap, offset, size);
+      simple_mtx_unlock(&heap->lock);
+      return NULL;
+   }
 
    s->heap = heap;
    s->offset = offset;
@@ -233,6 +238,16 @@ fd_bo_heap_alloc(struct fd_bo_heap *heap, uint32_t size, uint32_t flags)
       heap->blocks[idx] = fd_bo_new(
             heap->dev, FD_BO_HEAP_BLOCK_SIZE, heap->flags | _FD_BO_HINT_HEAP,
             "heap-%x-block-%u", heap->flags, idx);
+      if (!heap->blocks[idx]) {
+         /* GPU memory exhausted (GEM_NEW failed even after the BO caches were
+          * purged): give the range back and let the caller fail cleanly, instead
+          * of fd_bo_ref(NULL) below.
+          */
+         util_vma_heap_free(&heap->heap, offset, size);
+         simple_mtx_unlock(&heap->lock);
+         free(s);
+         return NULL;
+      }
       if (heap->flags == RING_FLAGS)
          fd_bo_mark_for_dump(heap->blocks[idx]);
    }
